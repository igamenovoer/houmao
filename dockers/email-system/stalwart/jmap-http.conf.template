map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${STALWART_HTTP_PORT};
    resolver 127.0.0.11 valid=5s ipv6=off;
    set $stalwart_upstream stalwart:${STALWART_HTTP_PORT};
    client_max_body_size 0;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 1h;

    location = /jmap/session {
        proxy_pass http://$stalwart_upstream;
        proxy_set_header Accept-Encoding "";
        sub_filter_types application/json;
        sub_filter_once off;
        sub_filter 'https://127.0.0.1:${STALWART_WEBADMIN_PORT}' 'http://127.0.0.1:${STALWART_HTTP_PORT}';
        sub_filter 'wss://127.0.0.1:${STALWART_WEBADMIN_PORT}' 'ws://127.0.0.1:${STALWART_HTTP_PORT}';
    }

    location / {
        proxy_pass http://$stalwart_upstream;
    }
}

server {
    listen ${BULWARK_HTTP_PORT};
    resolver 127.0.0.11 valid=5s ipv6=off;
    set $stalwart_upstream stalwart:${STALWART_HTTP_PORT};
    client_max_body_size 0;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 1h;

    location = /jmap/session {
        proxy_pass http://$stalwart_upstream;
        proxy_set_header Accept-Encoding "";
        sub_filter_types application/json;
        sub_filter_once off;
        sub_filter 'https://127.0.0.1:${STALWART_WEBADMIN_PORT}' 'http://127.0.0.1:${BULWARK_HTTP_PORT}';
        sub_filter 'wss://127.0.0.1:${STALWART_WEBADMIN_PORT}' 'ws://127.0.0.1:${BULWARK_HTTP_PORT}';
    }

    location = /.well-known/jmap {
        proxy_pass http://$stalwart_upstream;
    }

    location = /jmap {
        proxy_pass http://$stalwart_upstream;
    }

    location /jmap/ {
        proxy_pass http://$stalwart_upstream;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
