STACK_PROJECT_NAME=houmao-email-system # Docker Compose project name for the local email stack.
STALWART_IMAGE=ghcr.io/stalwartlabs/stalwart:v1.2.0 # Stalwart image used for this development stack.
JMAP_HTTP_IMAGE=nginx:1.28-alpine # Loopback proxy for JMAP and webmail.
BULWARK_IMAGE=ghcr.io/bulwarkmail/webmail:1.21.3 # Browser webmail image.
MAIL_DOMAIN=houmao.localhost # Mail domain that the provisioning helper creates in Stalwart.
STALWART_HOSTNAME=mail.houmao.localhost # Hostname advertised by Stalwart for the local development mail system.
STALWART_BOOTSTRAP_USER=bootstrap # Hidden fallback-admin username used only by the provisioning helper to bootstrap the real admin mailbox.
STALWART_BOOTSTRAP_PASSWORD=admin # Hidden fallback-admin password used only by the provisioning helper during local bring-up.
STALWART_ADMIN_USER=admin # Provisioned Stalwart superuser mailbox login for webadmin, the management API, IMAP, and SMTP auth.
STALWART_ADMIN_PASSWORD=admin # Password assigned to the provisioned Stalwart superuser mailbox login.
SEED_MAILBOX_NAME=admin # Default mailbox principal created for the first login and verification flow.
SEED_MAILBOX_PASSWORD=admin # Password assigned to the default seeded mailbox principal.
SEED_MAILBOX_EMAIL=admin@houmao.localhost # Primary email address assigned to the default seeded mailbox principal.
OPERATOR_MAILBOX_PASSWORD=admin # Password for the houmao-operator mailbox on MAIL_DOMAIN.
STALWART_HTTP_PORT=10080 # Stalwart's internal HTTP listener and host management API port.
STALWART_WEBADMIN_PORT=10082 # Browser-compatible HTTPS port for Stalwart Webadmin.
STALWART_IMAP_PORT=10143 # High-port IMAP listener for local mail clients.
STALWART_SUBMISSION_PORT=10587 # High-port SMTP submission listener for local mail clients.
BULWARK_HTTP_PORT=10081 # Loopback origin for Bulwark webmail and its JMAP requests.
