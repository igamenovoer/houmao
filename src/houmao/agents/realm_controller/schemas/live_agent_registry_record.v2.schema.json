{
  "$defs": {
    "RegistryGatewayV1": {
      "additionalProperties": false,
      "description": "Optional live gateway connect metadata published into the registry.",
      "properties": {
        "host": {
          "enum": [
            "127.0.0.1",
            "0.0.0.0"
          ],
          "title": "Host",
          "type": "string"
        },
        "port": {
          "title": "Port",
          "type": "integer"
        },
        "state_path": {
          "title": "State Path",
          "type": "string"
        },
        "protocol_version": {
          "const": "v1",
          "title": "Protocol Version",
          "type": "string"
        }
      },
      "required": [
        "host",
        "port",
        "state_path",
        "protocol_version"
      ],
      "title": "RegistryGatewayV1",
      "type": "object"
    },
    "RegistryIdentityV1": {
      "additionalProperties": false,
      "description": "Identity metadata for one published managed-agent record.",
      "properties": {
        "backend": {
          "enum": [
            "local_interactive",
            "codex_headless",
            "codex_app_server",
            "claude_headless",
            "kimi_headless",
            "dsh_acp",
            "dsh_web",
            "cao_rest",
            "houmao_server_rest"
          ],
          "title": "Backend",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "tool"
      ],
      "title": "RegistryIdentityV1",
      "type": "object"
    },
    "RegistryMailboxFilesystemV1": {
      "additionalProperties": false,
      "description": "Filesystem mailbox identity metadata for one published managed-agent session.",
      "properties": {
        "transport": {
          "const": "filesystem",
          "title": "Transport",
          "type": "string"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "filesystem_root": {
          "title": "Filesystem Root",
          "type": "string"
        },
        "bindings_version": {
          "title": "Bindings Version",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "principal_id",
        "address",
        "filesystem_root",
        "bindings_version"
      ],
      "title": "RegistryMailboxFilesystemV1",
      "type": "object"
    },
    "RegistryMailboxStalwartV1": {
      "additionalProperties": false,
      "description": "Stalwart mailbox identity metadata for one published managed-agent session.",
      "properties": {
        "transport": {
          "const": "stalwart",
          "title": "Transport",
          "type": "string"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "bindings_version": {
          "title": "Bindings Version",
          "type": "string"
        },
        "jmap_url": {
          "title": "Jmap Url",
          "type": "string"
        },
        "management_url": {
          "title": "Management Url",
          "type": "string"
        },
        "login_identity": {
          "title": "Login Identity",
          "type": "string"
        },
        "credential_ref": {
          "title": "Credential Ref",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "principal_id",
        "address",
        "bindings_version",
        "jmap_url",
        "management_url",
        "login_identity",
        "credential_ref"
      ],
      "title": "RegistryMailboxStalwartV1",
      "type": "object"
    },
    "RegistryRuntimeV1": {
      "additionalProperties": false,
      "description": "Pointers to runtime-owned state for one managed-agent record.",
      "properties": {
        "manifest_path": {
          "title": "Manifest Path",
          "type": "string"
        },
        "session_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Root"
        },
        "agent_def_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Def Dir"
        }
      },
      "required": [
        "manifest_path"
      ],
      "title": "RegistryRuntimeV1",
      "type": "object"
    },
    "RegistryTerminalV1": {
      "additionalProperties": false,
      "description": "Legacy live-session terminal hints for schema-version 2 registry payloads.",
      "properties": {
        "kind": {
          "const": "tmux",
          "default": "tmux",
          "title": "Kind",
          "type": "string"
        },
        "session_name": {
          "title": "Session Name",
          "type": "string"
        }
      },
      "required": [
        "session_name"
      ],
      "title": "RegistryTerminalV1",
      "type": "object"
    },
    "TerminalNativeSurfaceV1": {
      "additionalProperties": false,
      "description": "Identify an actual terminal interface rather than a supervisor log pane.",
      "properties": {
        "kind": {
          "const": "terminal",
          "default": "terminal",
          "title": "Kind",
          "type": "string"
        },
        "tmux_session_name": {
          "minLength": 1,
          "title": "Tmux Session Name",
          "type": "string"
        },
        "pane_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pane Id"
        }
      },
      "required": [
        "tmux_session_name"
      ],
      "title": "TerminalNativeSurfaceV1",
      "type": "object"
    },
    "WebNativeSurfaceV1": {
      "additionalProperties": false,
      "description": "Expose only a loopback browser origin and the exact bound native session.",
      "properties": {
        "kind": {
          "const": "web",
          "default": "web",
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "native_session_id": {
          "minLength": 1,
          "title": "Native Session Id",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "native_session_id"
      ],
      "title": "WebNativeSurfaceV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Legacy v2 shared-registry ``record.json`` contract for one live agent.",
  "properties": {
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "generation_id": {
      "title": "Generation Id",
      "type": "string"
    },
    "published_at": {
      "title": "Published At",
      "type": "string"
    },
    "lease_expires_at": {
      "title": "Lease Expires At",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/RegistryIdentityV1"
    },
    "native_surface": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "terminal": "#/$defs/TerminalNativeSurfaceV1",
              "web": "#/$defs/WebNativeSurfaceV1"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TerminalNativeSurfaceV1"
            },
            {
              "$ref": "#/$defs/WebNativeSurfaceV1"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Surface"
    },
    "runtime": {
      "$ref": "#/$defs/RegistryRuntimeV1"
    },
    "terminal": {
      "$ref": "#/$defs/RegistryTerminalV1"
    },
    "gateway": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegistryGatewayV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mailbox": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "filesystem": "#/$defs/RegistryMailboxFilesystemV1",
              "stalwart": "#/$defs/RegistryMailboxStalwartV1"
            },
            "propertyName": "transport"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RegistryMailboxFilesystemV1"
            },
            {
              "$ref": "#/$defs/RegistryMailboxStalwartV1"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mailbox"
    }
  },
  "required": [
    "agent_name",
    "agent_id",
    "generation_id",
    "published_at",
    "lease_expires_at",
    "identity",
    "runtime",
    "terminal"
  ],
  "title": "LiveAgentRegistryRecordV2",
  "type": "object"
}
