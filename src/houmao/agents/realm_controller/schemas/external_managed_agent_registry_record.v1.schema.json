{
  "$defs": {
    "ControllerScopeV1": {
      "additionalProperties": false,
      "description": "Record controller scope admitted by provisioned OS transport policy.",
      "properties": {
        "controller_id": {
          "title": "Controller Id",
          "type": "string"
        },
        "authority": {
          "enum": [
            "local_uid",
            "sudo_policy",
            "ssh_account",
            "container_exec"
          ],
          "title": "Authority",
          "type": "string"
        },
        "operations": {
          "items": {
            "enum": [
              "describe",
              "launch",
              "state",
              "inspect",
              "capture",
              "resume",
              "prompt",
              "interrupt",
              "stop",
              "relaunch",
              "home",
              "status",
              "refresh_check",
              "refresh",
              "gateway_status",
              "gateway_attach",
              "gateway_detach",
              "cleanup"
            ],
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        },
        "project_roots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Project Roots",
          "type": "array"
        }
      },
      "required": [
        "controller_id",
        "authority",
        "operations"
      ],
      "title": "ControllerScopeV1",
      "type": "object"
    },
    "ExecutionBindingV1": {
      "additionalProperties": false,
      "description": "Separate observed owner identity and controller scope from logical agent identity.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "context_id": {
          "title": "Context Id",
          "type": "string"
        },
        "host_id": {
          "title": "Host Id",
          "type": "string"
        },
        "account": {
          "title": "Account",
          "type": "string"
        },
        "uid": {
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        },
        "gid": {
          "minimum": 0,
          "title": "Gid",
          "type": "integer"
        },
        "groups": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Groups",
          "type": "array"
        },
        "registry_root": {
          "title": "Registry Root",
          "type": "string"
        },
        "runtime_root": {
          "title": "Runtime Root",
          "type": "string"
        },
        "project_root": {
          "title": "Project Root",
          "type": "string"
        },
        "profile_name": {
          "title": "Profile Name",
          "type": "string"
        },
        "transport": {
          "enum": [
            "local",
            "sudo",
            "ssh",
            "docker"
          ],
          "title": "Transport",
          "type": "string"
        },
        "controller": {
          "$ref": "#/$defs/ControllerScopeV1"
        },
        "route_fingerprint": {
          "title": "Route Fingerprint",
          "type": "string"
        },
        "container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Id"
        },
        "tmux_socket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tmux Socket"
        }
      },
      "required": [
        "context_id",
        "host_id",
        "account",
        "uid",
        "gid",
        "registry_root",
        "runtime_root",
        "project_root",
        "profile_name",
        "transport",
        "controller",
        "route_fingerprint"
      ],
      "title": "ExecutionBindingV1",
      "type": "object"
    },
    "HoumaoManagedAgentIdentity": {
      "additionalProperties": false,
      "description": "Transport-neutral managed-agent identity.",
      "properties": {
        "tracked_agent_id": {
          "title": "Tracked Agent Id",
          "type": "string"
        },
        "transport": {
          "enum": [
            "tui",
            "headless",
            "service",
            "web",
            "unknown"
          ],
          "title": "Transport",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "headless",
                "service",
                "tui",
                "web"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "backend": {
          "anyOf": [
            {
              "enum": [
                "local_interactive",
                "codex_headless",
                "codex_app_server",
                "claude_headless",
                "kimi_headless",
                "kimi_acp",
                "dsh_headless",
                "dsh_acp",
                "dsh_web",
                "hermes_tui",
                "hermes_service",
                "hermes_headless",
                "kimi_web",
                "cao_rest",
                "houmao_server_rest"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "native_surface": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "terminal": "#/$defs/TerminalNativeSurfaceV1",
                  "web": "#/$defs/WebNativeSurfaceV1"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TerminalNativeSurfaceV1"
                },
                {
                  "$ref": "#/$defs/WebNativeSurfaceV1"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Surface"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "session_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Name"
        },
        "terminal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Id"
        },
        "runtime_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Session Id"
        },
        "tmux_session_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tmux Session Name"
        },
        "tmux_window_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tmux Window Name"
        },
        "manifest_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Path"
        },
        "session_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Root"
        },
        "agent_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Name"
        },
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "lifecycle_state": {
          "anyOf": [
            {
              "enum": [
                "active",
                "stopped",
                "relaunching",
                "retired"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lifecycle State"
        },
        "management_kind": {
          "anyOf": [
            {
              "enum": [
                "local_lifecycle",
                "external_communication_only",
                "executor_managed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Management Kind"
        },
        "lifecycle_owner": {
          "anyOf": [
            {
              "enum": [
                "local",
                "remote",
                "executor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lifecycle Owner"
        },
        "external_agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Agent Id"
        },
        "remote_pair_api_base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Pair Api Base Url"
        },
        "remote_agent_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Agent Ref"
        },
        "execution_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionBindingV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_status": {
          "anyOf": [
            {
              "enum": [
                "available",
                "unavailable",
                "unverified",
                "conflict"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Status"
        }
      },
      "required": [
        "tracked_agent_id",
        "transport",
        "tool"
      ],
      "title": "HoumaoManagedAgentIdentity",
      "type": "object"
    },
    "TerminalNativeSurfaceV1": {
      "additionalProperties": false,
      "description": "Identify an actual terminal interface rather than a supervisor log pane.",
      "properties": {
        "kind": {
          "const": "terminal",
          "default": "terminal",
          "title": "Kind",
          "type": "string"
        },
        "tmux_session_name": {
          "minLength": 1,
          "title": "Tmux Session Name",
          "type": "string"
        },
        "pane_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pane Id"
        }
      },
      "required": [
        "tmux_session_name"
      ],
      "title": "TerminalNativeSurfaceV1",
      "type": "object"
    },
    "WebNativeSurfaceV1": {
      "additionalProperties": false,
      "description": "Expose only a loopback browser origin and the exact bound native session.",
      "properties": {
        "kind": {
          "const": "web",
          "default": "web",
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "native_session_id": {
          "minLength": 1,
          "title": "Native Session Id",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "native_session_id"
      ],
      "title": "WebNativeSurfaceV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Communication-only registry contract for an externally owned managed agent.",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "external_communication_only",
      "default": "external_communication_only",
      "title": "Kind",
      "type": "string"
    },
    "local_name": {
      "title": "Local Name",
      "type": "string"
    },
    "external_agent_id": {
      "title": "External Agent Id",
      "type": "string"
    },
    "generation_id": {
      "title": "Generation Id",
      "type": "string"
    },
    "pair_api_base_url": {
      "title": "Pair Api Base Url",
      "type": "string"
    },
    "remote_agent_ref": {
      "title": "Remote Agent Ref",
      "type": "string"
    },
    "gateway_expected": {
      "default": false,
      "title": "Gateway Expected",
      "type": "boolean"
    },
    "lifecycle_owner": {
      "const": "remote",
      "default": "remote",
      "title": "Lifecycle Owner",
      "type": "string"
    },
    "created_at_utc": {
      "title": "Created At Utc",
      "type": "string"
    },
    "updated_at_utc": {
      "title": "Updated At Utc",
      "type": "string"
    },
    "verified_at_utc": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified At Utc"
    },
    "cached_identity": {
      "$ref": "#/$defs/HoumaoManagedAgentIdentity"
    }
  },
  "required": [
    "local_name",
    "external_agent_id",
    "generation_id",
    "pair_api_base_url",
    "remote_agent_ref",
    "created_at_utc",
    "updated_at_utc",
    "cached_identity"
  ],
  "title": "ExternalManagedAgentRegistryRecordV1",
  "type": "object"
}
