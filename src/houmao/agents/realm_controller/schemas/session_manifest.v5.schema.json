          "type": "string"
        },
        "host_id": {
          "title": "Host Id",
          "type": "string"
        },
        "account": {
          "title": "Account",
          "type": "string"
        },
        "uid": {
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        },
        "gid": {
          "minimum": 0,
          "title": "Gid",
          "type": "integer"
        },
        "groups": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Groups",
          "type": "array"
        },
        "registry_root": {
          "title": "Registry Root",
          "type": "string"
        },
        "runtime_root": {
          "title": "Runtime Root",
          "type": "string"
        },
        "project_root": {
          "title": "Project Root",
          "type": "string"
        },
        "profile_name": {
          "title": "Profile Name",
          "type": "string"
        },
        "transport": {
          "enum": [
            "local",
            "sudo",
            "ssh",
            "docker"
          ],
          "title": "Transport",
          "type": "string"
        },
        "controller": {
          "$ref": "#/$defs/ControllerScopeV1"
        },
        "route_fingerprint": {
          "title": "Route Fingerprint",
          "type": "string"
        },
        "container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Id"
        },
        "tmux_socket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tmux Socket"
        }
      },
      "required": [
        "context_id",
        "host_id",
        "account",
        "uid",
        "gid",
        "registry_root",
        "runtime_root",
        "project_root",
        "profile_name",
        "transport",
        "controller",
        "route_fingerprint"
