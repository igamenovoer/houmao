        },
        "operations": {
          "items": {
            "enum": [
              "describe",
              "launch",
              "state",
              "inspect",
              "capture",
              "resume",
              "prompt",
              "interrupt",
              "stop",
              "relaunch",
              "home",
              "status",
              "refresh_check",
              "refresh",
              "gateway_status",
              "gateway_attach",
              "gateway_detach",
              "cleanup"
            ],
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        },
        "project_roots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Project Roots",
          "type": "array"
        }
      },
      "required": [
        "controller_id",
        "authority",
        "operations"
      ],
      "title": "ControllerScopeV1",
      "type": "object"
    },
    "ExecutionBindingV1": {
      "additionalProperties": false,
      "description": "Separate observed owner identity and controller scope from logical agent identity.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "context_id": {
