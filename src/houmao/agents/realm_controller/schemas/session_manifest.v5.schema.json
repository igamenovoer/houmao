    "CaoSectionV2": {
      "additionalProperties": false,
      "description": "Persisted CAO backend section.",
      "properties": {
        "api_base_url": {
          "title": "Api Base Url",
          "type": "string"
        },
        "session_name": {
          "title": "Session Name",
          "type": "string"
        },
        "terminal_id": {
          "title": "Terminal Id",
          "type": "string"
        },
        "profile_name": {
          "title": "Profile Name",
          "type": "string"
        },
        "profile_path": {
          "title": "Profile Path",
          "type": "string"
        },
        "tmux_window_name": {
          "anyOf": [
            {
              "type": "string"
