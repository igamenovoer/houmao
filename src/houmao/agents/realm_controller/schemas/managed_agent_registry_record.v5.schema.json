{
  "$defs": {
    "ControllerScopeV1": {
      "additionalProperties": false,
      "description": "Record controller scope admitted by provisioned OS transport policy.",
      "properties": {
        "controller_id": {
          "title": "Controller Id",
          "type": "string"
        },
        "authority": {
          "enum": [
            "local_uid",
            "sudo_policy",
            "ssh_account",
            "container_exec"
          ],
          "title": "Authority",
          "type": "string"
        },
        "operations": {
          "items": {
            "enum": [
              "describe",
              "launch",
              "state",
              "inspect",
              "capture",
              "resume",
              "prompt",
              "interrupt",
              "stop",
              "relaunch",
              "home",
              "status",
              "refresh_check",
              "refresh",
              "gateway_status",
              "gateway_attach",
              "gateway_detach",
              "cleanup"
            ],
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        },
        "project_roots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Project Roots",
          "type": "array"
        }
      },
      "required": [
        "controller_id",
        "authority",
        "operations"
      ],
      "title": "ControllerScopeV1",
      "type": "object"
    },
    "ExecutionBindingV1": {
      "additionalProperties": false,
      "description": "Separate observed owner identity and controller scope from logical agent identity.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "context_id": {
          "title": "Context Id",
          "type": "string"
        },
        "host_id": {
          "title": "Host Id",
          "type": "string"
        },
        "account": {
          "title": "Account",
          "type": "string"
        },
        "uid": {
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        },
        "gid": {
          "minimum": 0,
          "title": "Gid",
          "type": "integer"
        },
        "groups": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Groups",
          "type": "array"
        },
        "registry_root": {
          "title": "Registry Root",
          "type": "string"
        },
        "runtime_root": {
          "title": "Runtime Root",
          "type": "string"
        },
        "project_root": {
          "title": "Project Root",
          "type": "string"
        },
        "profile_name": {
          "title": "Profile Name",
          "type": "string"
        },
        "transport": {
          "enum": [
            "local",
            "sudo",
            "ssh",
            "docker"
          ],
          "title": "Transport",
          "type": "string"
        },
        "controller": {
          "$ref": "#/$defs/ControllerScopeV1"
        },
        "route_fingerprint": {
          "title": "Route Fingerprint",
          "type": "string"
        },
        "container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Id"
        },
        "tmux_socket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tmux Socket"
        }
      },
      "required": [
        "context_id",
        "host_id",
        "account",
        "uid",
        "gid",
        "registry_root",
        "runtime_root",
        "project_root",
        "profile_name",
        "transport",
        "controller",
        "route_fingerprint"
      ],
      "title": "ExecutionBindingV1",
      "type": "object"
    },
    "GatewayEndpointDescriptor": {
      "additionalProperties": false,
      "description": "Publish a live endpoint and its access requirements without credentials.",
      "properties": {
        "protocol": {
          "title": "Protocol",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/GatewayTarget"
        },
        "presence_id": {
          "title": "Presence Id",
          "type": "string"
        },
        "advertised_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Advertised Url"
        },
        "admin_access": {
          "enum": [
            "open",
            "key_required",
            "unavailable"
          ],
          "title": "Admin Access",
          "type": "string"
        },
        "private_proof": {
          "default": "self_or_admin",
          "enum": [
            "none",
            "self_or_admin",
            "unavailable"
          ],
          "title": "Private Proof",
          "type": "string"
        },
        "public_operations": {
          "default": [],
          "items": {
            "enum": [
              "messages",
              "public_prompt"
            ],
            "type": "string"
          },
          "title": "Public Operations",
          "type": "array"
        }
      },
      "required": [
        "protocol",
        "target",
        "presence_id",
        "advertised_url",
        "admin_access"
      ],
      "title": "GatewayEndpointDescriptor",
      "type": "object"
    },
    "GatewayOwner": {
      "additionalProperties": false,
      "description": "Pin a logical agent to its observed execution context.",
      "properties": {
        "agent_id": {
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$",
          "title": "Agent Id",
          "type": "string"
        },
        "context_id": {
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$",
          "title": "Context Id",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "context_id"
      ],
      "title": "GatewayOwner",
      "type": "object"
    },
    "GatewayTarget": {
      "additionalProperties": false,
      "description": "Identify the current incarnation reachable through an ingress.",
      "properties": {
        "owner": {
          "$ref": "#/$defs/GatewayOwner"
        },
        "incarnation": {
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$",
          "title": "Incarnation",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "incarnation"
      ],
      "title": "GatewayTarget",
      "type": "object"
    },
    "RegistryGatewayV1": {
      "additionalProperties": false,
      "description": "Optional live gateway connect metadata published into the registry.",
      "properties": {
        "host": {
          "enum": [
            "127.0.0.1",
            "0.0.0.0"
          ],
          "title": "Host",
          "type": "string"
        },
        "port": {
          "title": "Port",
          "type": "integer"
        },
        "state_path": {
          "title": "State Path",
          "type": "string"
        },
        "protocol_version": {
          "const": "v1",
          "title": "Protocol Version",
          "type": "string"
        },
        "owner_connect_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Connect Url"
        },
        "endpoint_descriptor": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayEndpointDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "host",
        "port",
        "state_path",
        "protocol_version"
      ],
      "title": "RegistryGatewayV1",
      "type": "object"
    },
    "RegistryIdentityV1": {
      "additionalProperties": false,
      "description": "Identity metadata for one published managed-agent record.",
      "properties": {
        "backend": {
          "enum": [
            "local_interactive",
            "codex_headless",
            "codex_app_server",
            "claude_headless",
            "kimi_headless",
            "kimi_acp",
            "dsh_headless",
            "dsh_acp",
            "dsh_web",
            "kimi_web",
            "cao_rest",
            "houmao_server_rest"
          ],
          "title": "Backend",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "tool"
      ],
      "title": "RegistryIdentityV1",
      "type": "object"
    },
    "RegistryLifecycleV1": {
      "additionalProperties": false,
      "description": "Lifecycle metadata for one managed-agent registry record.",
      "properties": {
        "state": {
          "enum": [
            "active",
            "stopped",
            "relaunching",
            "retired"
          ],
          "title": "State",
          "type": "string"
        },
        "relaunchable": {
          "title": "Relaunchable",
          "type": "boolean"
        },
        "state_updated_at": {
          "title": "State Updated At",
          "type": "string"
        },
        "stopped_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stopped At"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        }
      },
      "required": [
        "state",
        "relaunchable",
        "state_updated_at"
      ],
      "title": "RegistryLifecycleV1",
      "type": "object"
    },
    "RegistryLivenessV1": {
      "additionalProperties": false,
      "description": "Active-only liveness metadata for one managed-agent record.",
      "properties": {
        "published_at": {
          "title": "Published At",
          "type": "string"
        },
        "lease_expires_at": {
          "title": "Lease Expires At",
          "type": "string"
        }
      },
      "required": [
        "published_at",
        "lease_expires_at"
      ],
      "title": "RegistryLivenessV1",
      "type": "object"
    },
    "RegistryMailboxBindingV1": {
      "additionalProperties": false,
      "description": "Public mail identity projection without backend credentials or resolver inputs.",
      "properties": {
        "agent_id": {
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "offline",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "binding_id": {
          "minLength": 1,
          "title": "Binding Id",
          "type": "string"
        },
        "address": {
          "minLength": 1,
          "title": "Address",
          "type": "string"
        },
        "transport": {
          "enum": [
            "filesystem",
            "registry",
            "stalwart"
          ],
          "title": "Transport",
          "type": "string"
        },
        "availability": {
          "default": "unknown",
          "enum": [
            "configured",
            "unavailable",
            "unknown"
          ],
          "title": "Availability",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "channel",
        "binding_id",
        "address",
        "transport"
      ],
      "title": "RegistryMailboxBindingV1",
      "type": "object"
    },
    "RegistryMailboxSlotV1": {
      "additionalProperties": false,
      "description": "A public projection of one revisioned slot.",
      "properties": {
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegistryMailboxBindingV1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision",
        "binding"
      ],
      "title": "RegistryMailboxSlotV1",
      "type": "object"
    },
    "RegistryMailboxesV1": {
      "additionalProperties": false,
      "description": "Safe identity summaries for both independent channels.",
      "properties": {
        "offline": {
          "$ref": "#/$defs/RegistryMailboxSlotV1"
        },
        "online": {
          "$ref": "#/$defs/RegistryMailboxSlotV1"
        }
      },
      "required": [
        "offline",
        "online"
      ],
      "title": "RegistryMailboxesV1",
      "type": "object"
    },
    "RegistryRuntimeV1": {
      "additionalProperties": false,
      "description": "Pointers to runtime-owned state for one managed-agent record.",
      "properties": {
        "manifest_path": {
          "title": "Manifest Path",
          "type": "string"
        },
        "session_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Root"
        },
        "agent_def_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Def Dir"
        }
      },
      "required": [
        "manifest_path"
      ],
      "title": "RegistryRuntimeV1",
      "type": "object"
    },
    "RegistryTerminalV2": {
      "additionalProperties": false,
      "description": "Terminal-container hints for lifecycle-aware registry payloads.",
      "properties": {
        "kind": {
          "const": "tmux",
          "default": "tmux",
          "title": "Kind",
          "type": "string"
        },
        "current_session_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Session Name"
        },
        "last_session_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Session Name"
        },
        "socket_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Socket Path"
        }
      },
      "title": "RegistryTerminalV2",
      "type": "object"
    },
    "TerminalNativeSurfaceV1": {
      "additionalProperties": false,
      "description": "Identify an actual terminal interface rather than a supervisor log pane.",
      "properties": {
        "kind": {
          "const": "terminal",
          "default": "terminal",
          "title": "Kind",
          "type": "string"
        },
        "tmux_session_name": {
          "minLength": 1,
          "title": "Tmux Session Name",
          "type": "string"
        },
        "pane_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pane Id"
        }
      },
      "required": [
        "tmux_session_name"
      ],
      "title": "TerminalNativeSurfaceV1",
      "type": "object"
    },
    "WebNativeSurfaceV1": {
      "additionalProperties": false,
      "description": "Expose only a loopback browser origin and the exact bound native session.",
      "properties": {
        "kind": {
          "const": "web",
          "default": "web",
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "native_session_id": {
          "minLength": 1,
          "title": "Native Session Id",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "native_session_id"
      ],
      "title": "WebNativeSurfaceV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Lifecycle-aware shared-registry ``record.json`` contract.",
  "properties": {
    "schema_version": {
      "const": 5,
      "default": 5,
      "title": "Schema Version",
      "type": "integer"
    },
    "execution_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionBindingV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "generation_id": {
      "title": "Generation Id",
      "type": "string"
    },
    "lifecycle": {
      "$ref": "#/$defs/RegistryLifecycleV1"
    },
    "identity": {
      "$ref": "#/$defs/RegistryIdentityV1"
    },
    "mode": {
      "enum": [
        "headless",
        "service",
        "tui",
        "web"
      ],
      "title": "Mode",
      "type": "string"
    },
    "native_surface": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "terminal": "#/$defs/TerminalNativeSurfaceV1",
              "web": "#/$defs/WebNativeSurfaceV1"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TerminalNativeSurfaceV1"
            },
            {
              "$ref": "#/$defs/WebNativeSurfaceV1"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Surface"
    },
    "runtime": {
      "$ref": "#/$defs/RegistryRuntimeV1"
    },
    "terminal": {
      "$ref": "#/$defs/RegistryTerminalV2"
    },
    "liveness": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegistryLivenessV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gateway": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegistryGatewayV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mailboxes": {
      "$ref": "#/$defs/RegistryMailboxesV1"
    },
    "canonical_mail_identity": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Canonical Mail Identity"
    }
  },
  "required": [
    "agent_name",
    "agent_id",
    "generation_id",
    "lifecycle",
    "identity",
    "mode",
    "runtime",
    "terminal",
    "mailboxes",
    "canonical_mail_identity"
  ],
  "title": "ManagedAgentRegistryRecordV3",
  "type": "object"
}
