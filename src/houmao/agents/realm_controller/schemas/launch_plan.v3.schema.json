{
  "$defs": {
    "ControllerScopeV1": {
      "additionalProperties": false,
      "description": "Record controller scope admitted by provisioned OS transport policy.",
      "properties": {
        "controller_id": {
          "title": "Controller Id",
          "type": "string"
        },
        "authority": {
          "enum": [
            "local_uid",
            "sudo_policy",
            "ssh_account",
            "container_exec"
          ],
          "title": "Authority",
          "type": "string"
        },
        "operations": {
          "items": {
            "enum": [
              "describe",
              "launch",
              "state",
              "inspect",
              "capture",
              "resume",
              "prompt",
              "interrupt",
              "stop",
              "relaunch",
              "home",
              "status",
              "refresh_check",
              "refresh",
              "gateway_status",
              "gateway_attach",
              "gateway_detach",
              "cleanup"
            ],
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        },
        "project_roots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Project Roots",
          "type": "array"
        }
      },
      "required": [
        "controller_id",
        "authority",
        "operations"
      ],
      "title": "ControllerScopeV1",
      "type": "object"
    },
    "ExecutionBindingV1": {
      "additionalProperties": false,
      "description": "Separate observed owner identity and controller scope from logical agent identity.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "context_id": {
          "title": "Context Id",
          "type": "string"
        },
        "host_id": {
          "title": "Host Id",
          "type": "string"
        },
        "account": {
          "title": "Account",
          "type": "string"
        },
        "uid": {
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        },
        "gid": {
          "minimum": 0,
          "title": "Gid",
          "type": "integer"
        },
        "groups": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Groups",
          "type": "array"
        },
        "registry_root": {
          "title": "Registry Root",
          "type": "string"
        },
        "runtime_root": {
          "title": "Runtime Root",
          "type": "string"
        },
        "project_root": {
          "title": "Project Root",
          "type": "string"
        },
        "profile_name": {
          "title": "Profile Name",
          "type": "string"
        },
        "transport": {
          "enum": [
            "local",
            "sudo",
            "ssh",
            "docker"
          ],
          "title": "Transport",
          "type": "string"
        },
        "controller": {
          "$ref": "#/$defs/ControllerScopeV1"
        },
        "route_fingerprint": {
          "title": "Route Fingerprint",
          "type": "string"
        },
        "container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Id"
        },
        "tmux_socket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tmux Socket"
        }
      },
      "required": [
        "context_id",
        "host_id",
        "account",
        "uid",
        "gid",
        "registry_root",
        "runtime_root",
        "project_root",
        "profile_name",
        "transport",
        "controller",
        "route_fingerprint"
      ],
      "title": "ExecutionBindingV1",
      "type": "object"
    },
    "LaunchPlanHomeSelectorV1": {
      "additionalProperties": false,
      "description": "`home_selector` payload for `launch_plan.v1`.",
      "properties": {
        "env_var": {
          "title": "Env Var",
          "type": "string"
        },
        "home_path": {
          "title": "Home Path",
          "type": "string"
        }
      },
      "required": [
        "env_var",
        "home_path"
      ],
      "title": "LaunchPlanHomeSelectorV1",
      "type": "object"
    },
    "LaunchPlanMailboxFilesystemV1": {
      "additionalProperties": false,
      "description": "Persisted filesystem mailbox binding for `launch_plan.v1`.",
      "properties": {
        "transport": {
          "const": "filesystem",
          "title": "Transport",
          "type": "string"
        },
        "channel": {
          "const": "offline",
          "title": "Channel",
          "type": "string"
        },
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "registry_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registry Root"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "bindings_version": {
          "title": "Bindings Version",
          "type": "string"
        },
        "filesystem_root": {
          "title": "Filesystem Root",
          "type": "string"
        },
        "mailbox_kind": {
          "default": "in_root",
          "enum": [
            "in_root",
            "symlink"
          ],
          "title": "Mailbox Kind",
          "type": "string"
        },
        "mailbox_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mailbox Path"
        }
      },
      "required": [
        "transport",
        "channel",
        "agent_id",
        "binding_id",
        "principal_id",
        "address",
        "bindings_version",
        "filesystem_root"
      ],
      "title": "LaunchPlanMailboxFilesystemV1",
      "type": "object"
    },
    "LaunchPlanMailboxRegistryV1": {
      "additionalProperties": false,
      "description": "Protected remote offline binding; no registry-local paths are accepted.",
      "properties": {
        "transport": {
          "const": "registry",
          "title": "Transport",
          "type": "string"
        },
        "channel": {
          "const": "offline",
          "title": "Channel",
          "type": "string"
        },
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "bindings_version": {
          "title": "Bindings Version",
          "type": "string"
        },
        "registry_url": {
          "title": "Registry Url",
          "type": "string"
        },
        "credential_ref": {
          "title": "Credential Ref",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "channel",
        "agent_id",
        "binding_id",
        "principal_id",
        "address",
        "bindings_version",
        "registry_url",
        "credential_ref"
      ],
      "title": "LaunchPlanMailboxRegistryV1",
      "type": "object"
    },
    "LaunchPlanMailboxStalwartV1": {
      "additionalProperties": false,
      "description": "Persisted Stalwart mailbox binding for `launch_plan.v1`.",
      "properties": {
        "transport": {
          "const": "stalwart",
          "title": "Transport",
          "type": "string"
        },
        "channel": {
          "const": "online",
          "title": "Channel",
          "type": "string"
        },
        "provider": {
          "const": "stalwart",
          "title": "Provider",
          "type": "string"
        },
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "principal_id": {
          "title": "Principal Id",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "bindings_version": {
          "title": "Bindings Version",
          "type": "string"
        },
        "jmap_url": {
          "title": "Jmap Url",
          "type": "string"
        },
        "management_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Management Url"
        },
        "account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "identity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Id"
        },
        "credential_source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Source Ref"
        },
        "login_identity": {
          "title": "Login Identity",
          "type": "string"
        },
        "credential_ref": {
          "title": "Credential Ref",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "channel",
        "provider",
        "agent_id",
        "binding_id",
        "principal_id",
        "address",
        "bindings_version",
        "jmap_url",
        "login_identity",
        "credential_ref"
      ],
      "title": "LaunchPlanMailboxStalwartV1",
      "type": "object"
    },
    "LaunchPlanRoleInjectionV1": {
      "additionalProperties": false,
      "description": "`role_injection` payload for `launch_plan.v1`.",
      "properties": {
        "method": {
          "enum": [
            "native_developer_instructions",
            "native_append_system_prompt",
            "native_home_system_prompt",
            "native_system_prompt_section",
            "bootstrap_message",
            "cao_profile"
          ],
          "title": "Method",
          "type": "string"
        },
        "role_name": {
          "title": "Role Name",
          "type": "string"
        }
      },
      "required": [
        "method",
        "role_name"
      ],
      "title": "LaunchPlanRoleInjectionV1",
      "type": "object"
    },
    "LaunchPolicyProvenanceV1": {
      "additionalProperties": false,
      "description": "Typed launch-policy provenance persisted in launch/session payloads.",
      "properties": {
        "requested_operator_prompt_mode": {
          "enum": [
            "as_is",
            "unattended"
          ],
          "title": "Requested Operator Prompt Mode",
          "type": "string"
        },
        "detected_tool_version": {
          "title": "Detected Tool Version",
          "type": "string"
        },
        "selected_strategy_id": {
          "title": "Selected Strategy Id",
          "type": "string"
        },
        "selection_source": {
          "enum": [
            "registry",
            "env_override"
          ],
          "title": "Selection Source",
          "type": "string"
        },
        "override_env_var_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Env Var Name"
        }
      },
      "required": [
        "requested_operator_prompt_mode",
        "detected_tool_version",
        "selected_strategy_id",
        "selection_source"
      ],
      "title": "LaunchPolicyProvenanceV1",
      "type": "object"
    },
    "MailboxSlotPayloadV1": {
      "additionalProperties": false,
      "description": "Persisted slot authority, including empty-slot tombstone revisions.",
      "properties": {
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "binding": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "filesystem": "#/$defs/LaunchPlanMailboxFilesystemV1",
                  "registry": "#/$defs/LaunchPlanMailboxRegistryV1",
                  "stalwart": "#/$defs/LaunchPlanMailboxStalwartV1"
                },
                "propertyName": "transport"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/LaunchPlanMailboxFilesystemV1"
                },
                {
                  "$ref": "#/$defs/LaunchPlanMailboxStalwartV1"
                },
                {
                  "$ref": "#/$defs/LaunchPlanMailboxRegistryV1"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Binding"
        }
      },
      "required": [
        "revision",
        "binding"
      ],
      "title": "MailboxSlotPayloadV1",
      "type": "object"
    },
    "MailboxesPayloadV1": {
      "additionalProperties": false,
      "description": "Both mailbox channels, each with independent revision authority.",
      "properties": {
        "offline": {
          "$ref": "#/$defs/MailboxSlotPayloadV1"
        },
        "online": {
          "$ref": "#/$defs/MailboxSlotPayloadV1"
        }
      },
      "required": [
        "offline",
        "online"
      ],
      "title": "MailboxesPayloadV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Persisted `launch_plan.v3` payload.",
  "properties": {
    "schema_version": {
      "const": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "backend": {
      "enum": [
        "local_interactive",
        "codex_headless",
        "codex_app_server",
        "claude_headless",
        "kimi_headless",
        "kimi_acp",
        "dsh_headless",
        "dsh_acp",
        "dsh_web",
        "hermes_tui",
        "hermes_service",
        "hermes_headless",
        "kimi_web",
        "cao_rest",
        "houmao_server_rest"
      ],
      "title": "Backend",
      "type": "string"
    },
    "mode": {
      "enum": [
        "headless",
        "service",
        "tui",
        "web"
      ],
      "title": "Mode",
      "type": "string"
    },
    "native_surface_kind": {
      "anyOf": [
        {
          "enum": [
            "terminal",
            "web"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Surface Kind"
    },
    "execution_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionBindingV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "executable": {
      "title": "Executable",
      "type": "string"
    },
    "args": {
      "items": {
        "type": "string"
      },
      "title": "Args",
      "type": "array"
    },
    "working_directory": {
      "title": "Working Directory",
      "type": "string"
    },
    "home_selector": {
      "$ref": "#/$defs/LaunchPlanHomeSelectorV1"
    },
    "env_var_names": {
      "items": {
        "type": "string"
      },
      "title": "Env Var Names",
      "type": "array"
    },
    "role_injection": {
      "$ref": "#/$defs/LaunchPlanRoleInjectionV1"
    },
    "metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "items": {},
            "type": "array"
          },
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Metadata",
      "type": "object"
    },
    "mailboxes": {
      "$ref": "#/$defs/MailboxesPayloadV1"
    },
    "launch_policy_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/LaunchPolicyProvenanceV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "backend",
    "mode",
    "tool",
    "executable",
    "args",
    "working_directory",
    "home_selector",
    "env_var_names",
    "role_injection",
    "metadata",
    "mailboxes"
  ],
  "title": "LaunchPlanPayloadV1",
  "type": "object"
}
