+#[test]
+fn gateway_read_preserves_deferred_groups_and_serializes_with_dispatch() {
+    let f = Fixture::new();
+    let lease = f.lease(&f.bob);
+    let caps = f.rpc(&f.bob, "capabilities", json!({})).unwrap();
+    assert_eq!(caps["features"]["chat_gateway_queue_reads"], true);
+    assert!(
+        caps["operations"]
+            .as_array()
+            .unwrap()
+            .contains(&json!("chat.gateway-read.claim"))
+    );
+
+    for id in ["first", "second", "third"] {
+        f.send(id, id);
+    }
+    let offered = f.rpc(&f.bob, "lease.next", lease.clone()).unwrap()["offers"]
+        .as_array()
+        .unwrap()
+        .clone();
+    let first = &offered[0]["attempt_id"];
+    let second = &offered[1]["attempt_id"];
+    let third = &offered[2]["attempt_id"];
+    let mut settlement = f.start(&lease, &offered[..2]);
+    let claim = queue_claim(&lease, "read-1", json!([[first, second], [third]]));
+    assert_eq!(
+        f.rpc(&f.bob, "chat.gateway-read.claim", claim.clone())
+            .unwrap_err()
+            .code,
+        "queue_snapshot_stale"
+    );
+    settlement["outcome"] = json!("deferred");
+    f.rpc(&f.bob, "lease.settle", settlement).unwrap();
+
+    for wrong in [
+        json!([[second, first], [third]]),
+        json!([[first]]),
+        json!([[first], [second]]),
+    ] {
+        assert_eq!(
+            f.rpc(
+                &f.bob,
+                "chat.gateway-read.claim",
+                queue_claim(&lease, "read-1", wrong)
+            )
+            .unwrap_err()
+            .code,
+            "queue_snapshot_stale"
+        );
+    }
+    let mut too_small = claim.clone();
+    too_small["max_bytes"] = json!(1);
+    assert_eq!(
+        f.rpc(&f.bob, "chat.gateway-read.claim", too_small)
+            .unwrap_err()
+            .code,
+        "content_limit"
+    );
+    let too_many = (0..=v2::MAX_BATCH)
+        .map(|idx| format!("attempt-{idx}"))
+        .collect::<Vec<_>>();
+    assert_eq!(
+        f.rpc(
+            &f.bob,
+            "chat.gateway-read.claim",
+            queue_claim(&lease, "read-1", json!([too_many]))
+        )
+        .unwrap_err()
+        .code,
+        "content_limit"
+    );
+    assert_eq!(
+        f.rpc(
+            &f.bob,
+            "chat.gateway-read.result",
+            queue_result_args("read-1")
+        )
+        .unwrap()["found"],
+        false
+    );
+
+    let actual = f
+        .rpc(&f.bob, "chat.gateway-read.claim", claim.clone())
+        .unwrap();
+    assert_eq!(actual["status"], "pending");
+    assert_eq!(actual["groups"][0][0]["attempt_id"], *first);
+    assert_eq!(actual["groups"][0][1]["attempt_id"], *second);
+    assert_eq!(actual["groups"][1][0]["attempt_id"], *third);
+    assert_eq!(actual["groups"][1][0]["event_id"], offered[2]["event_id"]);
+    let mut start = lease.clone();
+    start["dispatch_id"] = json!("late");
+    start["attempt_ids"] = json!([first, second]);
+    assert_eq!(
+        f.rpc(&f.bob, "lease.start", start).unwrap_err().code,
+        "dispatch_conflict"
+    );
+
+    f.send("fourth", "next eligible");
+    let next = f.rpc(&f.bob, "lease.next", lease).unwrap();
+    assert_eq!(next["offers"].as_array().unwrap().len(), 1);
+    assert_eq!(next["offers"][0]["text"], "next eligible");
+    assert_eq!(
+        f.rpc(&f.bob, "chat.gateway-read.claim", claim).unwrap(),
+        actual
+    );
+}
+
+#[test]
+fn gateway_read_reconciles_and_acknowledges_across_receiver_epochs() {
+    let f = Fixture::new();
+    let lease = f.lease(&f.bob);
+    let sent = f.send("outbound", "durable");
+    let offered = f.rpc(&f.bob, "lease.next", lease.clone()).unwrap()["offers"][0].clone();
+    let claim = queue_claim(&lease, "recover", json!([[offered["attempt_id"]]]));
+    let read = f
+        .rpc(&f.bob, "chat.gateway-read.claim", claim.clone())
+        .unwrap();
+    // Loading a new State from the disk must not rely on a current lease or the daemon boot.
+    f.rpc(&f.bob, "lease.release", lease.clone()).unwrap();
+    let replacement = f.lease(&f.bob);
+    assert_ne!(lease, replacement);
+    assert_eq!(
+        f.rpc(
+            &f.bob,
+            "chat.gateway-read.result",
+            queue_result_args("recover")
+        )
+        .unwrap(),
+        read
+    );
+    assert_eq!(
+        f.rpc(&f.bob, "chat.gateway-read.claim", claim.clone())
+            .unwrap(),
+        read
+    );
+    let mut different = claim.clone();
+    different["snapshot_fingerprint"] = json!("c".repeat(64));
+    assert_eq!(
+        f.rpc(&f.bob, "chat.gateway-read.claim", different)
+            .unwrap_err()
+            .code,
+        "operation_conflict"
+    );
+    assert_eq!(
+        f.rpc(
+            &f.bob,
+            "chat.gateway-read.claim",
+            queue_claim(&lease, "fresh", json!([[offered["attempt_id"]]]))
+        )
+        .unwrap_err()
+        .code,
+        "receiver_lease_lost"
+    );
+
+    let mut foreign = queue_result_args("recover");
+    foreign["binding_tag"] = json!("e".repeat(64));
+    assert_eq!(
+        f.rpc(&f.bob, "chat.gateway-read.result", foreign.clone())
+            .unwrap()["found"],
+        false
+    );
+    assert_eq!(
+        f.rpc(
+            &f.alice,
+            "chat.gateway-read.result",
+            queue_result_args("recover")
+        )
+        .unwrap()["found"],
+        false
+    );
+    let ack = json!({"receipt": read["receipt"], "binding_tag": "a".repeat(64)});
+    let wrong_tag = json!({"receipt": read["receipt"], "binding_tag": foreign["binding_tag"]});
+    for (actor, args) in [(&f.bob, wrong_tag), (&f.alice, ack.clone())] {
+        assert_eq!(
+            f.rpc(actor, "chat.ack", args).unwrap_err().code,
+            "receipt_scope_error"
+        );
+    }
+    let acknowledged = f.rpc(&f.bob, "chat.ack", ack.clone()).unwrap();
+    assert_eq!(
+        acknowledged,
+        json!({"receipt":read["receipt"],"acknowledged":true,"attempt_ids":[offered["attempt_id"]]})
+    );
+    assert_eq!(f.rpc(&f.bob, "chat.ack", ack).unwrap(), acknowledged);
+    let after = f
+        .rpc(
+            &f.bob,
+            "chat.gateway-read.result",
+            queue_result_args("recover"),
+        )
+        .unwrap();
+    assert_eq!(after["groups"], read["groups"]);
+    assert_eq!(after["status"], "acknowledged");
+    let deliveries = f
+        .rpc(
+            &f.alice,
+            "chat.deliveries",
+            json!({"event_id":sent["event"]["id"]}),
+        )
+        .unwrap();
+    assert_eq!(deliveries["deliveries"][0]["state"], "gateway_tool_read");
+}
+
+#[test]
+fn expired_gateway_read_is_uncertain_and_retains_operation_identity() {
+    let f = Fixture::new();
+    let lease = f.lease(&f.bob);
+    let sent = f.send("outbound", "may have been exposed");
+    let offered = f.rpc(&f.bob, "lease.next", lease.clone()).unwrap()["offers"][0].clone();
+    let claim = queue_claim(&lease, "expired", json!([[offered["attempt_id"]]]));
+    let read = f
+        .rpc(&f.bob, "chat.gateway-read.claim", claim.clone())
+        .unwrap();
+    let mut state = read_state(&f.home, &f.group.group_id).unwrap();
+    gateway_read::expire_ack_for_test(&mut state);
+    save_state(&f.home, &f.group.group_id, &state).unwrap();
+
+    let result_args = queue_result_args("expired");
+    let recovered = f
+        .rpc(&f.bob, "chat.gateway-read.result", result_args.clone())
+        .unwrap();
+    assert_eq!(recovered["status"], "uncertain");
+    assert_eq!(recovered["groups"], read["groups"]);
+    assert_eq!(
+        f.rpc(
+            &f.bob,
+            "chat.ack",
+            json!({"receipt":read["receipt"], "binding_tag":"a".repeat(64)})
+        )
+        .unwrap_err()
+        .code,
+        "queue_read_expired"
+    );
+    assert_eq!(
+        f.rpc(&f.bob, "lease.next", lease.clone()).unwrap()["offers"],
+        json!([])
+    );
+    let receipts = f
+        .rpc(
+            &f.alice,
+            "chat.deliveries",
+            json!({"event_id":sent["event"]["id"]}),
+        )
+        .unwrap();
+    assert_eq!(receipts["deliveries"][0]["state"], "uncertain");
+    assert_eq!(
+        receipts["deliveries"][0]["error_code"],
+        "gateway_read_ack_expired"
+    );
+    assert_eq!(
+        f.rpc(
+            &f.alice,
+            "chat.retry",
+            json!({"event_id":sent["event"]["id"], "actor_ids":["bob"]})
+        )
+        .unwrap_err()
+        .code,
+        "uncertain_conflict"
+    );
+
+    let mut state = read_state(&f.home, &f.group.group_id).unwrap();
+    gateway_read::expire_recovery_for_test(&mut state);
+    save_state(&f.home, &f.group.group_id, &state).unwrap();
+    assert_eq!(
+        f.rpc(&f.bob, "chat.gateway-read.result", result_args)
+            .unwrap_err()
+            .code,
+        "queue_read_expired"
+    );
+    assert_eq!(
+        f.rpc(&f.bob, "chat.gateway-read.claim", claim)
+            .unwrap_err()
+            .code,
+        "queue_read_expired"
+    );
+    f.send("later", "younger work");
+    let next = f.rpc(&f.bob, "lease.next", lease.clone()).unwrap()["offers"][0].clone();
+    let replacement = queue_claim(&lease, "expired", json!([[next["attempt_id"]]]));
+    assert_eq!(
+        f.rpc(&f.bob, "chat.gateway-read.claim", replacement)
+            .unwrap_err()
+            .code,
+        "operation_conflict"
+    );
+}
