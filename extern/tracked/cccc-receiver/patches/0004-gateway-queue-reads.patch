+fn queue_claim(lease: &Value, operation_id: &str, groups: Value) -> Value {
+    json!({
+        "lease_id": lease["lease_id"],
+        "lease_generation": lease["lease_generation"],
+        "binding_tag": "a".repeat(64),
+        "operation_id": operation_id,
+        "snapshot_fingerprint": "b".repeat(64),
+        "groups": groups,
+    })
+}
+
+fn queue_result_args(operation_id: &str) -> Value {
+    json!({"binding_tag": "a".repeat(64), "operation_id": operation_id})
+}
