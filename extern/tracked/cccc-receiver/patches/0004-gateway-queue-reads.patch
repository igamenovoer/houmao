+++ b/crates/cccc-daemon/src/ops/external_receiver/gateway_read.rs
@@ -0,0 +1,443 @@
+//! Exact, durable tool-read claims for the staged gateway chat queue.
+use super::*;
+use std::collections::BTreeSet;
+
+pub(super) const ACK_MS: u64 = 300_000;
+pub(super) const RECOVERY_MS: u64 = 86_400_000;
+
+#[derive(Deserialize, Serialize)]
+pub(super) struct GatewayRead {
+    actor: String,
+    actor_generation: String,
+    binding_tag: String,
+    operation_id: String,
+    snapshot_fingerprint: String,
+    groups: Vec<Vec<String>>,
+    receipt: String,
+    ack_expires_ms: u64,
+    recovery_expires_ms: u64,
+    max_bytes: usize,
+    acknowledged: bool,
+}
+
+impl GatewayRead {
+    fn scoped(&self, grant: &Grant, binding_tag: &str) -> bool {
+        self.actor == grant.actor_id
+            && self.actor_generation == grant.actor_generation
+            && self.binding_tag == binding_tag
+    }
+
+    fn unresolved(&self, now: u64) -> bool {
+        !self.acknowledged && self.ack_expires_ms <= now
+    }
+
+    fn decision(&self, now: u64) -> &'static str {
+        if self.acknowledged {
+            "acknowledged"
+        } else if self.unresolved(now) {
+            "uncertain"
+        } else {
+            "pending"
+        }
+    }
+
+    fn acknowledgment(&self) -> OpResult {
+        object(json!({
+            "receipt": self.receipt,
+            "acknowledged": true,
+            "attempt_ids": self.groups.iter().flatten().collect::<Vec<_>>(),
+        }))
+    }
+}
+
+fn binding_tag(args: &Map<String, Value>) -> Result<String, OpError> {
+    sha256_arg(args, "binding_tag")
+}
+
+fn sha256_arg(args: &Map<String, Value>, name: &str) -> Result<String, OpError> {
+    let value = string(args, name)?;
+    if value.len() == 64
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    {
+        Ok(value)
+    } else {
+        Err(OpError::new("invalid_args", format!("Invalid {name}")))
+    }
+}
+
+fn operation_id(args: &Map<String, Value>) -> Result<String, OpError> {
+    let id = string(args, "operation_id")?;
+    if id.len() > 128
+        || !id.as_bytes()[0].is_ascii_alphanumeric()
+        || !id
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"._~-".contains(&b))
+    {
+        return Err(OpError::new("invalid_args", "Invalid operation ID"));
+    }
+    Ok(id)
+}
+
+fn limit_error() -> OpError {
+    OpError::new("content_limit", "Gateway read exceeds the selected bound")
+}
+
+fn stale() -> OpError {
+    OpError::new(
+        "queue_snapshot_stale",
+        "Gateway staged selection is no longer current",
+    )
+}
+
+fn expired() -> OpError {
+    OpError::new("queue_read_expired", "Gateway read or receipt has expired")
+}
+
+fn unavailable() -> OpError {
+    OpError::new(
+        "gateway_read_unavailable",
+        "Gateway read decision could not be verified",
+    )
+}
+
+fn max_bytes(args: &Map<String, Value>) -> Result<usize, OpError> {
+    match args.get("max_bytes") {
+        None => Ok(MAX_RESPONSE_BYTES),
+        Some(value) => value
+            .as_u64()
+            .and_then(|n| usize::try_from(n).ok())
+            .filter(|n| (1..=MAX_RESPONSE_BYTES).contains(n))
+            .ok_or_else(limit_error),
+    }
+}
+
+fn selection(args: &Map<String, Value>) -> Result<Vec<Vec<String>>, OpError> {
+    let groups = args
+        .get("groups")
+        .and_then(Value::as_array)
+        .filter(|groups| !groups.is_empty())
+        .ok_or_else(|| OpError::new("invalid_args", "Ordered attempt groups are required"))?;
+    let mut selected = BTreeSet::new();
+    let mut result = Vec::new();
+    for group in groups {
+        let items = group
+            .as_array()
+            .filter(|group| !group.is_empty())
+            .ok_or_else(|| OpError::new("invalid_args", "Empty or malformed attempt group"))?;
+        if items.len() > v2::MAX_BATCH - selected.len() {
+            return Err(limit_error());
+        }
+        let mut ids = Vec::with_capacity(items.len());
+        for item in items {
+            let id = item
+                .as_str()
+                .filter(|id| !id.is_empty() && id.len() <= 128)
+                .ok_or_else(|| OpError::new("invalid_args", "Invalid attempt ID"))?;
+            if !selected.insert(id) {
+                return Err(OpError::new("invalid_args", "Repeated attempt ID"));
+            }
+            ids.push(id.to_owned());
+        }
+        result.push(ids);
+    }
+    Ok(result)
+}
+
+fn read_indexes(
+    state: &State,
+    grant: &Grant,
+    current: &Lease,
+    groups: &[Vec<String>],
+) -> Result<Vec<usize>, OpError> {
+    let mut eligible = state.attempts.iter().enumerate().filter(|(_, attempt)| {
+        attempt.kind == "chat" && v2::scoped(attempt, grant) && v2::claimed(attempt, current)
+    });
+    if eligible
+        .clone()
+        .any(|(_, attempt)| attempt.state == "started")
+    {
+        return Err(stale());
+    }
+    let mut offered = eligible
+        .by_ref()
+        .filter(|(_, attempt)| attempt.state == "offered");
+    let mut indexes = Vec::new();
+    for group in groups {
+        for id in group {
+            let (index, attempt) = offered.next().ok_or_else(stale)?;
+            if &attempt.id != id || attempt.expiry_ms <= now_ms() {
+                return Err(stale());
+            }
+            if !attempt.dispatch_id.is_empty()
+                && state.dispatches.iter().any(|record| {
+                    record.id == attempt.dispatch_id
+                        && record.actor == grant.actor_id
+                        && record.lease_generation == current.generation
+                        && record.outcome == "deferred"
+                        && &record.attempt_ids != group
+                })
+            {
+                return Err(stale());
+            }
+            indexes.push(index);
+        }
+    }
+    Ok(indexes)
+}
+
+fn projection(
+    home: &HomeLayout,
+    grant: &Grant,
+    group: &GroupDoc,
+    state: &State,
+    read: &GatewayRead,
+    budget: usize,
+) -> OpResult {
+    let now = now_ms();
+    if read.recovery_expires_ms <= now {
+        return Err(expired());
+    }
+    let mut groups = Vec::with_capacity(read.groups.len());
+    for ids in &read.groups {
+        let mut messages = Vec::with_capacity(ids.len());
+        for id in ids {
+            let attempt = state
+                .attempts
+                .iter()
+                .find(|a| &a.id == id && a.kind == "chat" && v2::scoped(a, grant))
+                .ok_or_else(unavailable)?;
+            let event = visible_event(home, group, &grant.actor_id, &attempt.event_id)?;
+            let mode = event
+                .data
+                .get("message_mode")
+                .and_then(Value::as_str)
+                .unwrap_or("send");
+            let text = event
+                .data
+                .get("text")
+                .and_then(Value::as_str)
+                .or_else(|| event.data.get("message").and_then(Value::as_str))
+                .unwrap_or_default();
+            messages.push(json!({
+                "attempt_id": attempt.id,
+                "event_id": event.id,
+                "sequence": attempt.sequence,
+                "sender": event.by,
+                "timestamp": event.ts,
+                "message_mode": mode,
+                "text": text,
+            }));
+        }
+        groups.push(messages);
+    }
+    let status = read.decision(now);
+    let value = json!({
+        "found": true,
+        "operation_id": read.operation_id,
+        "snapshot_fingerprint": read.snapshot_fingerprint,
+        "receipt": read.receipt,
+        "status": status,
+        "groups": groups,
+    });
+    // Reserve the longest later receipt state before making a pending exposure durable.
+    let complete_bytes = serde_json::to_vec(&json!({"ok": true, "result": value}))
+        .map_err(OpError::invalid)?
+        .len()
+        + ("acknowledged".len() - status.len());
+    if complete_bytes > budget {
+        return Err(limit_error());
+    }
+    object(value)
+}
+
+pub(super) fn claim(
+    home: &HomeLayout,
+    grant: &Grant,
+    group: &GroupDoc,
+    args: &Map<String, Value>,
+) -> OpResult {
+    args_only(
+        args,
+        &[
+            "lease_id",
+            "lease_generation",
+            "binding_tag",
+            "operation_id",
+            "snapshot_fingerprint",
+            "groups",
+            "max_bytes",
+        ],
+    )?;
+    string(args, "lease_id")?;
+    if args
+        .get("lease_generation")
+        .and_then(Value::as_u64)
+        .is_none()
+    {
+        return Err(OpError::new("invalid_args", "lease_generation required"));
+    }
+    let binding_tag = binding_tag(args)?;
+    let operation_id = operation_id(args)?;
+    let snapshot_fingerprint = sha256_arg(args, "snapshot_fingerprint")?;
+    let groups = selection(args)?;
+    let max_bytes = max_bytes(args)?;
+    let mut state = read_state(home, &grant.group_id).map_err(|_| unavailable())?;
+    sweep(home, &grant.group_id, &mut state).map_err(|_| unavailable())?;
+    if let Some(read) = state
+        .gateway_reads
+        .iter()
+        .find(|read| read.scoped(grant, &binding_tag) && read.operation_id == operation_id)
+    {
+        if read.snapshot_fingerprint != snapshot_fingerprint || read.groups != groups {
+            return Err(OpError::new(
+                "operation_conflict",
+                "Gateway read selection changed",
+            ));
+        }
+        return projection(
+            home,
+            grant,
+            group,
+            &state,
+            read,
+            max_bytes.min(read.max_bytes),
+        );
+    }
+
+    if !actor(group, &grant.actor_id)?.enabled
+        || matches!(group.state, GroupState::Paused | GroupState::Stopped)
+    {
+        return Err(OpError::new(
+            "receiver_unavailable",
+            "Actor or Group is inactive",
+        ));
+    }
+    let current = lease(&state, grant, args)?;
+    if current.receiver != "gateway" {
+        return Err(OpError::new(
+            "receiver_transport_conflict",
+            "Gateway lease required",
+        ));
+    }
+    let indexes = read_indexes(&state, grant, current, &groups)?;
+    let now = now_ms();
+    let read = GatewayRead {
+        actor: grant.actor_id.clone(),
+        actor_generation: grant.actor_generation.clone(),
+        binding_tag,
+        operation_id,
+        snapshot_fingerprint,
+        groups,
+        receipt: uuid::Uuid::new_v4().simple().to_string(),
+        ack_expires_ms: now.saturating_add(ACK_MS),
+        recovery_expires_ms: now.saturating_add(RECOVERY_MS),
+        max_bytes,
+        acknowledged: false,
+    };
+    let response = projection(home, grant, group, &state, &read, max_bytes)?;
+    // History reconstruction may take time. Recheck deadline and lease immediately
+    // before committing, under the same global receiver mutation policy.
+    let current = lease(&state, grant, args)?;
+    read_indexes(&state, grant, current, &read.groups)?;
+    for i in indexes {
+        let attempt = &mut state.attempts[i];
+        attempt.state = "gateway_tool_retrieved".into();
+        attempt.deadline_ms = read.ack_expires_ms;
+        attempt.retryable = false;
+        attempt.error_code = None;
+    }
+    state.gateway_reads.push(read);
+    save_state(home, &grant.group_id, &state).map_err(|_| unavailable())?;
+    Ok(response)
+}
+
+pub(super) fn result(
+    home: &HomeLayout,
+    grant: &Grant,
+    group: &GroupDoc,
+    args: &Map<String, Value>,
+) -> OpResult {
+    args_only(args, &["binding_tag", "operation_id"])?;
+    let binding_tag = binding_tag(args)?;
+    let operation_id = operation_id(args)?;
+    let mut state = read_state(home, &grant.group_id).map_err(|_| unavailable())?;
+    sweep(home, &grant.group_id, &mut state).map_err(|_| unavailable())?;
+    match state
+        .gateway_reads
+        .iter()
+        .find(|read| read.scoped(grant, &binding_tag) && read.operation_id == operation_id)
+    {
+        Some(read) => projection(home, grant, group, &state, read, read.max_bytes),
+        None => object(json!({"found": false, "operation_id": operation_id})),
+    }
+}
+
+pub(super) fn ack(
+    home: &HomeLayout,
+    grant: &Grant,
+    group: &GroupDoc,
+    args: &Map<String, Value>,
+) -> OpResult {
+    args_only(args, &["binding_tag", "receipt"])?;
+    let binding_tag = binding_tag(args)?;
+    let receipt = string(args, "receipt")?;
+    let mut state = read_state(home, &grant.group_id).map_err(|_| unavailable())?;
+    sweep(home, &grant.group_id, &mut state).map_err(|_| unavailable())?;
+    let index = state
+        .gateway_reads
+        .iter()
+        .position(|read| read.scoped(grant, &binding_tag) && read.receipt == receipt)
+        .ok_or_else(|| OpError::new("receipt_scope_error", "Gateway read receipt unavailable"))?;
+    let read = &state.gateway_reads[index];
+    let now = now_ms();
+    if read.recovery_expires_ms <= now || read.unresolved(now) {
+        return Err(expired());
+    }
+    if read.acknowledged {
+        return read.acknowledgment();
+    }
+    let mut positions = Vec::new();
+    for id in read.groups.iter().flatten() {
+        let position = state
+            .attempts
+            .iter()
+            .position(|attempt| {
+                &attempt.id == id
+                    && v2::scoped(attempt, grant)
+                    && attempt.state == "gateway_tool_retrieved"
+                    && attempt.deadline_ms == read.ack_expires_ms
+            })
+            .ok_or_else(|| {
+                OpError::new("attempt_conflict", "Gateway read cannot be acknowledged")
+            })?;
+        positions.push(position);
+    }
+    for i in &positions {
+        let attempt = &mut state.attempts[*i];
+        attempt.state = "gateway_tool_read".into();
+        attempt.retryable = false;
+    }
+    state.gateway_reads[index].acknowledged = true;
+    save_state(home, &grant.group_id, &state).map_err(|_| unavailable())?;
+    for position in positions {
+        append_receipt(home, group, &state.attempts[position]).map_err(|_| unavailable())?;
+    }
+    state.gateway_reads[index].acknowledgment()
+}
+
+#[cfg(test)]
+pub(super) fn expire_ack_for_test(state: &mut State) {
+    state.gateway_reads[0].ack_expires_ms = 0;
+    for attempt in &mut state.attempts {
+        if attempt.state == "gateway_tool_retrieved" {
+            attempt.deadline_ms = 0;
+        }
+    }
+}
+
+#[cfg(test)]
+pub(super) fn expire_recovery_for_test(state: &mut State) {
+    state.gateway_reads[0].recovery_expires_ms = 0;
+}
