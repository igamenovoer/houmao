diff --git a/crates/cccc-web/src/routes/external_receiver.rs b/crates/cccc-web/src/routes/external_receiver.rs
new file mode 100644
index 00000000..0036a0b6
--- /dev/null
+++ b/crates/cccc-web/src/routes/external_receiver.rs
@@ -0,0 +1,198 @@
+//! Actor-only receiver RPC and separately authenticated operator provisioning.
+use crate::{AppState, auth::Principal};
+use axum::{
+    Extension, Json, Router,
+    extract::{Path, State},
+    http::{HeaderMap, StatusCode, header},
+    response::{IntoResponse, Response},
+    routing::{delete, post},
+};
+use cccc_contracts::DaemonRequest;
+use serde::Deserialize;
+use serde_json::{Map, Value, json};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Rpc {
+    operation: String,
+    arguments: Map<String, Value>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ActorInput {
+    group_id: String,
+    actor_id: String,
+}
+
+pub fn routes() -> Router<AppState> {
+    Router::new()
+        .route("/api/v1/external-receiver/v1/rpc", post(rpc))
+        .route("/api/v1/external-receiver/v1/grants", post(grant))
+        .route(
+            "/api/v1/external-receiver/v1/grants/{grant_id}",
+            delete(revoke),
+        )
+        .route("/api/v1/external-receiver/v1/takeover", post(takeover))
+}
+fn error(status: StatusCode, code: &str) -> Response {
+    (status,Json(json!({"ok":false,"error":{"code":code,"message":"CCCC external receiver request failed","retryable":matches!(status.as_u16(),409|503)}}))).into_response()
+}
+fn operator(state: &AppState, principal: &Principal, headers: &HeaderMap) -> bool {
+    !state.web_mode.is_read_only()
+        && principal.current_admin(&state.home).unwrap_or(false)
+        && (!headers.contains_key(header::AUTHORIZATION) || !principal.raw_token.is_empty())
+}
+async fn call(state: &AppState, op: &str, args: Map<String, Value>) -> Response {
+    match state
+        .client
+        .call(&DaemonRequest {
+            v: 1,
+            op: op.into(),
+            args,
+        })
+        .await
+    {
+        Ok(r) if r.ok => Json(json!({"ok":true,"result":r.result})).into_response(),
+        Ok(r) => {
+            let code = r.error.map_or_else(|| "provider_error".into(), |e| e.code);
+            let status = if code == "invalid_grant" {
+                StatusCode::UNAUTHORIZED
+            } else if code.contains("permission") {
+                StatusCode::FORBIDDEN
+            } else if code.contains("conflict")
+                || code == "actor_busy"
+                || code == "receiver_lease_lost"
+            {
+                StatusCode::CONFLICT
+            } else if code.ends_with("not_found") {
+                StatusCode::NOT_FOUND
+            } else if code.contains("unavailable") {
+                StatusCode::SERVICE_UNAVAILABLE
+            } else {
+                StatusCode::UNPROCESSABLE_ENTITY
+            };
+            error(status, &code)
+        }
+        Err(_) => error(StatusCode::SERVICE_UNAVAILABLE, "daemon_unavailable"),
+    }
+}
+async fn rpc(State(state): State<AppState>, headers: HeaderMap, Json(body): Json<Rpc>) -> Response {
+    let Some(token) = headers
+        .get(header::AUTHORIZATION)
+        .and_then(|v| v.to_str().ok())
+        .and_then(|v| v.strip_prefix("Bearer "))
+        .filter(|v| !v.is_empty())
+    else {
+        return error(StatusCode::UNAUTHORIZED, "invalid_grant");
+    };
+    let wait = if body.operation == "lease.next" {
+        body.arguments
+            .get("timeout_seconds")
+            .and_then(Value::as_f64)
+            .unwrap_or(0.0)
+            .clamp(0.0, 20.0)
+    } else {
+        0.0
+    };
+    let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs_f64(wait);
+    let args = json!({"token":token,"operation":body.operation,"arguments":body.arguments})
+        .as_object()
+        .unwrap()
+        .clone();
+    loop {
+        let response = match state
+            .client
+            .call(&DaemonRequest {
+                v: 1,
+                op: "external_receiver_rpc".into(),
+                args: args.clone(),
+            })
+            .await
+        {
+            Ok(v) => v,
+            Err(_) => return error(StatusCode::SERVICE_UNAVAILABLE, "daemon_unavailable"),
+        };
+        if response.ok {
+            let empty = response.result.get("offer") == Some(&Value::Null);
+            if body.operation == "lease.next" && empty && tokio::time::Instant::now() < deadline {
+                tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+                continue;
+            }
+            return Json(json!({"ok":true,"result":response.result})).into_response();
+        }
+        let code = response
+            .error
+            .map_or_else(|| "provider_error".into(), |e| e.code);
+        let status = if code == "invalid_grant" {
+            StatusCode::UNAUTHORIZED
+        } else if code.contains("permission") {
+            StatusCode::FORBIDDEN
+        } else if code.contains("conflict") || code.ends_with("lease_lost") {
+            StatusCode::CONFLICT
+        } else if code.ends_with("not_found") {
+            StatusCode::NOT_FOUND
+        } else if code.contains("unavailable") {
+            StatusCode::SERVICE_UNAVAILABLE
+        } else {
+            StatusCode::UNPROCESSABLE_ENTITY
+        };
+        return error(status, &code);
+    }
+}
+async fn grant(
+    State(state): State<AppState>,
+    Extension(principal): Extension<Principal>,
+    headers: HeaderMap,
+    Json(body): Json<ActorInput>,
+) -> Response {
+    if !operator(&state, &principal, &headers) {
+        return error(StatusCode::FORBIDDEN, "operator_required");
+    }
+    call(
+        &state,
+        "external_receiver_grant",
+        json!({"by":"user","group_id":body.group_id,"actor_id":body.actor_id})
+            .as_object()
+            .unwrap()
+            .clone(),
+    )
+    .await
+}
+async fn revoke(
+    State(state): State<AppState>,
+    Extension(principal): Extension<Principal>,
+    headers: HeaderMap,
+    Path(id): Path<String>,
+) -> Response {
+    if !operator(&state, &principal, &headers) {
+        return error(StatusCode::FORBIDDEN, "operator_required");
+    }
+    call(
+        &state,
+        "external_receiver_revoke",
+        json!({"by":"user","grant_id":id})
+            .as_object()
+            .unwrap()
+            .clone(),
+    )
+    .await
+}
+async fn takeover(
+    State(state): State<AppState>,
+    Extension(principal): Extension<Principal>,
+    headers: HeaderMap,
+    Json(body): Json<ActorInput>,
+) -> Response {
+    if !operator(&state, &principal, &headers) {
+        return error(StatusCode::FORBIDDEN, "operator_required");
+    }
+    call(
+        &state,
+        "external_receiver_takeover",
+        json!({"by":"user","group_id":body.group_id,"actor_id":body.actor_id})
+            .as_object()
+            .unwrap()
+            .clone(),
+    )
+    .await
+}
