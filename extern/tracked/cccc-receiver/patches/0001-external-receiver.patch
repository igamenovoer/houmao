+#[test]
+fn grants_are_actor_bound_and_do_not_create_native_processes() {
+    let f = Fixture::new();
+    let binding = f.rpc(&f.alice, "binding", json!({})).unwrap();
+    assert_eq!(binding["actor_id"], "alice");
+    assert_eq!(
+        f.rpc(&f.alice, "binding", json!({"actor_id":"bob"}))
+            .unwrap_err()
+            .code,
+        "invalid_args"
+    );
+    assert_eq!(
+        f.rpc("invalid", "binding", json!({})).unwrap_err().code,
+        "invalid_grant"
