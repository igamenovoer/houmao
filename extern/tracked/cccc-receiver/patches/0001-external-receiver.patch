+    outcome["outcome"] = json!("refused");
+    outcome["error_code"] = json!("body_busy");
+    f.rpc(&f.bob, "lease.outcome", outcome.clone()).unwrap();
+    f.rpc(&f.bob, "lease.outcome", outcome).unwrap();
+    assert!(f.rpc(&f.bob, "lease.next", lease.clone()).unwrap()["offer"].is_null());
+    assert_eq!(
