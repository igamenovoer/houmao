diff --git a/crates/cccc-daemon/src/ops/external_receiver/v2.rs b/crates/cccc-daemon/src/ops/external_receiver/v2.rs
new file mode 100644
index 00000000..510a53ce
--- /dev/null
+++ b/crates/cccc-daemon/src/ops/external_receiver/v2.rs
@@ -0,0 +1,968 @@
+//! Receiver v2 queue projection and scoped batch transitions.
+use super::*;
+
+const INTENTS_FIELD: &str = "_external_receiver_intents";
+const PENDING_MS: u64 = 86_400_000;
+const DIRECT_ACK_MS: u64 = 300_000;
+const MAX_PENDING: usize = 1024;
+const MAX_BATCH: usize = 64;
+
+#[derive(Clone, Deserialize, Serialize)]
+struct Intent {
+    id: String,
+    actor: String,
+    generation: String,
+    expiry_ms: u64,
+}
+
+#[derive(Deserialize, Serialize)]
+struct IntentRecord {
+    group_generation: String,
+    recipients: Vec<Intent>,
+}
+
+#[derive(Clone, Deserialize, Serialize)]
+pub(super) struct Dispatch {
+    id: String,
+    lease_generation: u64,
+    actor: String,
+    attempt_ids: Vec<String>,
+    outcome: String,
+    settlement: Option<String>,
+}
+
+impl Dispatch {
+    fn public(&self) -> Value {
+        json!({"dispatch_id":self.id,"attempt_ids":self.attempt_ids,"outcome":self.outcome})
+    }
+}
+
+#[derive(Clone, Deserialize, Serialize)]
+pub(super) struct DirectRead {
+    receipt: String,
+    actor: String,
+    actor_generation: String,
+    attempt_ids: Vec<String>,
+    expires_ms: u64,
+    acknowledged: bool,
+}
+
+impl DirectRead {
+    fn public(&self) -> Value {
+        json!({"receipt":self.receipt,"attempt_ids":self.attempt_ids,"acknowledged":self.acknowledged})
+    }
+}
+
+pub(in crate::ops) fn strip_intake_metadata(data: &mut Map<String, Value>) {
+    data.remove(INTENTS_FIELD);
+}
+
+pub(in crate::ops) fn attach_chat_intents(group: &GroupDoc, event: &mut Event) {
+    let recipients = group
+        .actors
+        .iter()
+        .filter(|actor| {
+            actor.external_receiver
+                && actor.enabled
+                && super::super::actor_delivery::event_targets_actor(group, event, &actor.id)
+        })
+        .map(intent_for)
+        .collect::<Vec<_>>();
+    if !recipients.is_empty() {
+        event.data.insert(
+            INTENTS_FIELD.into(),
+            json!(IntentRecord {
+                group_generation: group.generation.clone(),
+                recipients,
+            }),
+        );
+    }
+}
+
+fn intent_for(actor: &Actor) -> Intent {
+    Intent {
+        id: uuid::Uuid::new_v4().to_string(),
+        actor: actor.id.clone(),
+        generation: actors::generation_identity(actor),
+        expiry_ms: now_ms().saturating_add(PENDING_MS),
+    }
+}
+
+pub(super) fn next_sequence(state: &mut State) -> Result<u64, OpError> {
+    state.sequence = state
+        .sequence
+        .checked_add(1)
+        .ok_or_else(|| OpError::new("provider_error", "Delivery order exhausted"))?;
+    Ok(state.sequence)
+}
+
+pub(super) fn recover_pending(
+    home: &HomeLayout,
+    group_id: &str,
+    state: &mut State,
+) -> Result<bool, OpError> {
+    let path = GroupStore::new(home.clone())
+        .map_err(OpError::io)?
+        .ledger_path(group_id)
+        .map_err(OpError::io)?;
+    let (cursor, records) = ledger::inspect(&path, |events, positions| {
+        let start = positions
+            .get(&state.ledger_cursor)
+            .map_or(0, |index| index + 1);
+        let records = events[start..]
+            .iter()
+            .filter_map(|event| {
+                let value = event.data.get(INTENTS_FIELD)?;
+                if event.kind != "chat.message"
+                    || event.data.get("message_mode").and_then(Value::as_str) == Some("mail")
+                {
+                    return None;
+                }
+                let record = serde_json::from_value::<IntentRecord>(value.clone()).ok()?;
+                Some((event.id.clone(), record))
+            })
+            .collect::<Vec<_>>();
+        (
+            events
+                .last()
+                .map(|event| event.id.clone())
+                .unwrap_or_default(),
+            records,
+        )
+    })
+    .map_err(OpError::io)?;
+    let changed = cursor != state.ledger_cursor;
+    if !records.is_empty() {
+        let current = group(home, group_id)?;
+        for (event_id, record) in records {
+            if record.group_generation != current.generation {
+                continue;
+            }
+            for intent in record.recipients {
+                if state.attempts.iter().any(|attempt| {
+                    attempt.id == intent.id
+                        || (attempt.event_id == event_id
+                            && attempt.actor_id == intent.actor
+                            && attempt.actor_generation == intent.generation)
+                }) {
+                    continue;
+                }
+                queue(state, &event_id, intent)?;
+            }
+        }
+    }
+    state.ledger_cursor = cursor;
+    Ok(changed)
+}
+
+fn queue(state: &mut State, event_id: &str, intent: Intent) -> Result<Attempt, OpError> {
+    let occupied = state
+        .attempts
+        .iter()
+        .filter(|attempt| {
+            attempt.kind == "chat"
+                && attempt.actor_id == intent.actor
+                && attempt.actor_generation == intent.generation
+                && matches!(attempt.state.as_str(), "pending" | "offered" | "started")
+                && (attempt.state == "started" || attempt.expiry_ms > now_ms())
+        })
+        .count();
+    let (phase, error) = if intent.expiry_ms <= now_ms() {
+        ("failed", Some("pending_expired"))
+    } else if occupied >= MAX_PENDING {
+        ("refused", Some("pending_capacity"))
+    } else {
+        ("pending", None)
+    };
+    let attempt = Attempt {
+        id: intent.id,
+        event_id: event_id.into(),
+        actor_id: intent.actor,
+        actor_generation: intent.generation,
+        lease_id: String::new(),
+        lease_generation: 0,
+        state: phase.into(),
+        deadline_ms: 0,
+        offered: false,
+        boot: boot().into(),
+        retryable: true,
+        error_code: error.map(str::to_owned),
+        kind: "chat".into(),
+        sequence: next_sequence(state)?,
+        expiry_ms: intent.expiry_ms,
+        dispatch_id: String::new(),
+        credit_bytes: 0,
+    };
+    state.attempts.push(attempt.clone());
+    Ok(attempt)
+}
+
+pub(super) fn chat_offer(
+    home: &HomeLayout,
+    group: &GroupDoc,
+    actor: &Actor,
+    event: &Event,
+    retry: bool,
+    state: &mut State,
+) -> Result<bool, OpError> {
+    if event.kind != "chat.message"
+        || event.data.get("message_mode").and_then(Value::as_str) == Some("mail")
+    {
+        return Ok(false);
+    }
+    let generation = actors::generation_identity(actor);
+    if !retry {
+        // First offers are committed with the chat and recovered by read_state.
+        return Ok(state.attempts.iter().any(|attempt| {
+            attempt.event_id == event.id
+                && attempt.actor_id == actor.id
+                && attempt.actor_generation == generation
+                && attempt.state == "pending"
+        }));
+    }
+    let attempt = queue(state, &event.id, intent_for(actor))?;
+    save_state(home, &group.group_id, state)?;
+    append_receipt(home, group, &attempt)?;
+    Ok(attempt.state == "pending")
+}
+
+fn reset_to_pending(attempt: &mut Attempt) {
+    attempt.state = "pending".into();
+    attempt.lease_id.clear();
+    attempt.lease_generation = 0;
+    attempt.deadline_ms = 0;
+    attempt.dispatch_id.clear();
+    attempt.error_code = None;
+    attempt.offered = false;
+    attempt.credit_bytes = 0;
+}
+
+fn terminal(attempt: &mut Attempt, state: &str, error: &str, retryable: bool) {
+    attempt.state = state.into();
+    attempt.error_code = Some(error.into());
+    attempt.retryable = retryable;
+}
+
+pub(super) fn retire_attempt(attempt: &mut Attempt, reason: &str) -> bool {
+    match (attempt.kind.as_str(), attempt.state.as_str()) {
+        ("chat", "offered") => reset_to_pending(attempt),
+        ("chat", "started") | (_, "offered") => terminal(attempt, "uncertain", reason, true),
+        ("chat", _) => return false,
+        (_, "pending") => terminal(attempt, "failed", reason, true),
+        _ => return false,
+    }
+    true
+}
+
+pub(super) fn sweep_state(state: &mut State) -> (bool, Vec<Attempt>) {
+    let now = now_ms();
+    let count = state.leases.len();
+    state
+        .leases
+        .retain(|_, lease| lease.expires_ms > now && !lease.receiver.is_empty());
+    let mut dirty = state.leases.len() != count;
+    let mut terminalized = Vec::new();
+    for attempt in &mut state.attempts {
+        let current_lease = state.leases.get(&attempt.actor_id).is_some_and(|lease| {
+            lease.id == attempt.lease_id && lease.generation == attempt.lease_generation
+        });
+        let changed = if attempt.kind == "chat" {
+            match attempt.state.as_str() {
+                "pending" | "offered" if attempt.expiry_ms <= now => {
+                    terminal(attempt, "failed", "pending_expired", true);
+                    true
+                }
+                "offered" | "started" if !current_lease => {
+                    retire_attempt(attempt, "receiver_unavailable")
+                }
+                "started" if attempt.deadline_ms <= now || attempt.boot != boot() => {
+                    terminal(attempt, "uncertain", "handoff_timeout", true);
+                    true
+                }
+                "direct_retrieved" if attempt.deadline_ms <= now => {
+                    terminal(attempt, "uncertain", "direct_ack_expired", true);
+                    true
+                }
+                _ => false,
+            }
+        } else if !current_lease || attempt.deadline_ms <= now || attempt.boot != boot() {
+            retire_attempt(attempt, "receiver_unavailable")
+        } else {
+            false
+        };
+        if changed && matches!(attempt.state.as_str(), "failed" | "uncertain") {
+            terminalized.push(attempt.clone());
+        }
+        dirty |= changed;
+    }
+    // Expiry settles a started batch as a single decision in the same write.
+    for dispatch in state
+        .dispatches
+        .iter_mut()
+        .filter(|item| item.outcome == "started")
+    {
+        if state.attempts.iter().any(|attempt| {
+            attempt.dispatch_id == dispatch.id
+                && attempt.lease_generation == dispatch.lease_generation
+                && attempt.actor_id == dispatch.actor
+                && attempt.state == "uncertain"
+        }) {
+            dispatch.outcome = "uncertain".into();
+            dirty = true;
+        }
+    }
+    (dirty, terminalized)
+}
+
+pub(super) fn capabilities() -> Value {
+    json!({
+        "protocol_version": 2,
+        "operations": ["binding","capabilities","members","lease.acquire","lease.renew","lease.release",
+            "lease.next","lease.stream","lease.notice.next","lease.outcome","lease.start","lease.settle",
+            "chat.send","chat.reply","chat.retry","chat.history","chat.deliveries","chat.ack",
+            "mail.send","mail.reply","mail.peek","mail.cursor","mail.read","mail.read-receipts"],
+        "limits": {"max_event_bytes": MAX_EVENT_BYTES, "max_history_limit": 100,
+            "max_response_bytes": MAX_RESPONSE_BYTES, "lease_seconds": 45,
+            "max_batch_messages": MAX_BATCH, "max_batch_bytes": MAX_RESPONSE_BYTES,
+            "max_stream_seconds": 20, "max_pending_messages": MAX_PENDING,
+            "max_handoff_seconds": ATTEMPT_MS / 1000,
+            "pending_seconds": PENDING_MS / 1000, "max_mail_messages": 200, "max_mail_response_bytes": 1048576,
+            "default_mail_messages": 50, "default_mail_response_bytes": 262144},
+        "recipient_scope": "bound_group", "mail": true,
+        "features": {"chat_pending":true,"chat_batch_pull":true,"chat_push_stream":true,
+            "chat_batch_settlement":true,"chat_direct_pull":true,"chat_independent_notices":true,
+            "mail_expected_cursor":true,"mail_read_receipts":true,"mail_read_crash_recovery":true,
+            "mail_precommit_response_budget":true}
+    })
+}
+
+fn bound(args: &Map<String, Value>, key: &str, max: usize) -> Result<usize, OpError> {
+    match args.get(key) {
+        None => Ok(max),
+        Some(value) => value
+            .as_u64()
+            .and_then(|v| usize::try_from(v).ok())
+            .filter(|v| (1..=max).contains(v))
+            .ok_or_else(|| OpError::new("invalid_args", format!("Invalid {key}"))),
+    }
+}
+
+pub(super) fn default_offer_limit() -> usize {
+    MAX_EVENT_BYTES
+}
+
+pub(super) fn offer_limit(args: &Map<String, Value>) -> Result<usize, OpError> {
+    bound(args, "max_offer_bytes", default_offer_limit())
+}
+
+fn scoped(attempt: &Attempt, grant: &Grant) -> bool {
+    attempt.actor_id == grant.actor_id && attempt.actor_generation == grant.actor_generation
+}
+
+fn claimed(attempt: &Attempt, lease: &Lease) -> bool {
+    attempt.lease_id == lease.id && attempt.lease_generation == lease.generation
+}
+
+fn outstanding_credit(state: &State, grant: &Grant, lease: &Lease, kind: &str) -> (usize, usize) {
+    state
+        .attempts
+        .iter()
+        .filter(|attempt| {
+            scoped(attempt, grant)
+                && claimed(attempt, lease)
+                && attempt.kind == kind
+                && matches!(attempt.state.as_str(), "offered" | "started")
+        })
+        .fold((0, 0), |(count, bytes), attempt| {
+            (count + 1, bytes + attempt.credit_bytes)
+        })
+}
+
+fn stage(attempt: &mut Attempt, lease: &Lease, credit_bytes: usize) {
+    attempt.lease_id = lease.id.clone();
+    attempt.lease_generation = lease.generation;
+    attempt.offered = true;
+    attempt.state = "offered".into();
+    attempt.credit_bytes = credit_bytes;
+    attempt.boot = boot().into();
+}
+
+fn offer_packet(
+    home: &HomeLayout,
+    group: &GroupDoc,
+    grant: &Grant,
+    lease: &Lease,
+    attempt: &Attempt,
+) -> Result<Value, OpError> {
+    let notice = attempt.kind == "mail_notice";
+    let event = if notice {
+        mail::offered_event(home, group, &grant.actor_id, &attempt.event_id)?
+    } else {
+        visible_event(home, group, &grant.actor_id, &attempt.event_id)?
+    };
+    let expiry = if notice {
+        attempt.deadline_ms
+    } else {
+        attempt.expiry_ms
+    };
+    let mut packet = json!({
+        "attempt_id":attempt.id, "event_id":event.id, "group_id":grant.group_id,
+        "actor_id":grant.actor_id, "actor_generation":grant.actor_generation,
+        "lease_generation":lease.generation, "sequence":attempt.sequence, "timestamp":event.ts,
+        "message_mode":event.data.get("message_mode").and_then(Value::as_str).unwrap_or("send"),
+        "text":event.data.get("text").and_then(Value::as_str).or_else(|| event.data.get("message").and_then(Value::as_str)).unwrap_or_default(),
+        "sender":event.by, "reply_to":event.data.get("reply_to"),
+        "remaining_seconds":(expiry.saturating_sub(now_ms())) as f64 / 1000.0,
+    });
+    if notice {
+        packet["kind"] = json!("mail_notice");
+        packet["pending_count"] = json!(
+            event
+                .data
+                .get("context")
+                .and_then(|v| v.get("source_event_ids"))
+                .and_then(Value::as_array)
+                .map(Vec::len)
+                .unwrap_or(0)
+        );
+        packet["text"] = json!("");
+    } else if lease.receiver == "direct" {
+        packet["event_ref"] = json!(attempt.id);
+    }
+    Ok(packet)
+}
