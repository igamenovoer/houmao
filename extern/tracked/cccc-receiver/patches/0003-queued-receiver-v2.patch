+fn record_size_failure(
+    home: &HomeLayout,
+    group: &GroupDoc,
+    state: &mut State,
+    index: usize,
+) -> Result<(), OpError> {
+    terminal(
+        &mut state.attempts[index],
+        "failed",
+        "event_too_large",
+        false,
+    );
+    save_state(home, &group.group_id, state)?;
+    append_receipt(home, group, &state.attempts[index])
+}
+
+pub(super) fn pull(
+    home: &HomeLayout,
+    grant: &Grant,
+    group: &GroupDoc,
+    state: &mut State,
+    args: &Map<String, Value>,
+) -> OpResult {
+    args_only(
+        args,
+        &[
+            "lease_id",
+            "lease_generation",
+            "limit",
+            "max_bytes",
+            "timeout_seconds",
+        ],
+    )?;
+    if args.get("timeout_seconds").is_some_and(|v| {
+        v.as_f64()
+            .is_none_or(|v| !v.is_finite() || !(0.0..=20.0).contains(&v))
+    }) {
+        return Err(OpError::new(
+            "invalid_args",
+            "timeout_seconds must be numeric 0..20",
+        ));
+    }
+    let current = lease(state, grant, args)?.clone();
+    if current.transport != "pull" {
+        return Err(OpError::new(
+            "receiver_transport_conflict",
+            "Pull lease required",
+        ));
+    }
+    let limit = bound(args, "limit", MAX_BATCH)?;
+    let bytes = bound(args, "max_bytes", MAX_RESPONSE_BYTES)?;
+    let direct = current.receiver == "direct";
+    let (outstanding_count, outstanding_bytes) = outstanding_credit(state, grant, &current, "chat");
+    let limit = limit.min(MAX_BATCH.saturating_sub(outstanding_count));
+    let mut remaining_credit = MAX_RESPONSE_BYTES.saturating_sub(outstanding_bytes);
+    let receipt = direct.then(|| uuid::Uuid::new_v4().to_string());
+    let result_for = |offers: &[Value]| {
+        if direct {
+            json!({"offers":offers,"receipt":if offers.is_empty() { None } else { receipt.as_ref() }})
+        } else {
+            json!({"offers":offers})
+        }
+    };
+    let response_overhead = size(&json!({"ok":true,"result":result_for(&[])}))?;
+    if bytes < response_overhead {
+        return Err(OpError::new(
+            "content_limit",
+            "Pull budget cannot fit an empty response",
+        ));
+    }
+
+    let mut selected = Vec::new();
+    let mut offers = Vec::new();
+    for index in 0..state.attempts.len() {
+        if selected.len() >= limit {
+            break;
+        }
+        let attempt = &state.attempts[index];
+        if !scoped(attempt, grant) || attempt.kind != "chat" || attempt.state != "pending" {
+            continue;
+        }
+        let packet = offer_packet(home, group, grant, &current, attempt)?;
+        let packet_bytes = size(&packet)?;
+        if packet_bytes > current.max_offer_bytes {
+            if !selected.is_empty() {
+                break;
+            }
+            record_size_failure(home, group, state, index)?;
+            return Err(OpError::new(
+                "event_too_large",
+                "Event exceeds negotiated payload limit",
+            ));
+        }
+        offers.push(packet);
+        if size(&json!({"ok":true,"result":result_for(&offers)}))? > bytes {
+            offers.pop();
+            break;
+        }
+        let credit = packet_bytes.saturating_add(32);
+        if credit > remaining_credit {
+            offers.pop();
+            break;
+        }
+        selected.push((index, credit));
+        remaining_credit -= credit;
+    }
+    if !selected.is_empty() {
+        let expires_ms = now_ms().saturating_add(DIRECT_ACK_MS);
+        for (index, credit) in selected.iter().copied() {
+            let attempt = &mut state.attempts[index];
+            stage(attempt, &current, credit);
+            if direct {
+                attempt.state = "direct_retrieved".into();
+                attempt.deadline_ms = expires_ms;
+            }
+        }
+        if let Some(receipt) = &receipt {
+            state.direct_reads.push(DirectRead {
+                receipt: receipt.clone(),
+                actor: grant.actor_id.clone(),
+                actor_generation: grant.actor_generation.clone(),
+                attempt_ids: selected
+                    .iter()
+                    .map(|(index, _)| state.attempts[*index].id.clone())
+                    .collect(),
+                expires_ms,
+                acknowledged: false,
+            });
+        }
+        save_state(home, &grant.group_id, state)?;
+    }
+    object(result_for(&offers))
+}
+
+pub(super) fn stream_next(
+    home: &HomeLayout,
+    grant: &Grant,
+    group: &GroupDoc,
+    state: &mut State,
+    op: &str,
+    args: &Map<String, Value>,
+) -> OpResult {
+    let streaming = op == "lease.stream";
+    args_only(
+        args,
+        if streaming {
+            &[
+                "lease_id",
+                "lease_generation",
+                "kind",
+                "after_sequence",
+                "max_bytes",
+            ]
+        } else {
+            &["lease_id", "lease_generation"]
+        },
+    )?;
+    let current = lease(state, grant, args)?.clone();
+    if current.receiver != "gateway" || current.transport != if streaming { "push" } else { "pull" }
+    {
+        return Err(OpError::new(
+            "receiver_transport_conflict",
+            "Matching gateway lease required",
+        ));
+    }
+    let kind = if streaming {
+        string(args, "kind")?
+    } else {
+        "mail_notice".into()
+    };
+    if !matches!(kind.as_str(), "chat" | "mail_notice") {
+        return Err(OpError::new("invalid_args", "Unknown offer kind"));
+    }
+    let cursor = match args.get("after_sequence") {
+        None => 0,
+        Some(value) => value
+            .as_u64()
+            .ok_or_else(|| OpError::new("invalid_args", "Invalid offer cursor"))?,
+    };
+    let budget = bound(args, "max_bytes", MAX_RESPONSE_BYTES)?;
+    let index = state.attempts.iter().position(|attempt| {
+        scoped(attempt, grant)
+            && attempt.kind == kind
+            && attempt.sequence > cursor
+            && ((attempt.state == "pending" && (kind == "chat" || claimed(attempt, &current)))
+                || (streaming && attempt.state == "offered" && claimed(attempt, &current)))
+    });
+    let Some(index) = index else {
+        return object(json!({"offer":null, "credit_exhausted":false}));
+    };
+    let packet = offer_packet(home, group, grant, &current, &state.attempts[index])?;
+    let packet_bytes = size(&packet)?;
+    let offer_limit = if kind == "chat" {
+        current.max_offer_bytes
+    } else {
+        MAX_EVENT_BYTES
+    };
+    if packet_bytes > offer_limit {
+        record_size_failure(home, group, state, index)?;
+        return Err(OpError::new(
+            "event_too_large",
+            "Event exceeds negotiated payload limit",
+        ));
+    }
+    // Account for the complete NDJSON frame, including its newline delimiter.
+    if streaming && size(&json!({"kind":"offer","offer":packet}))? + 1 > budget {
+        return object(json!({"offer":null, "credit_exhausted":true}));
+    }
+    if state.attempts[index].state == "pending" {
+        let credit = packet_bytes.saturating_add(32);
+        let (count, bytes) = outstanding_credit(state, grant, &current, &kind);
+        if count >= MAX_BATCH || credit > MAX_RESPONSE_BYTES.saturating_sub(bytes) {
+            return object(json!({"offer":null, "credit_exhausted":true}));
+        }
+        stage(&mut state.attempts[index], &current, credit);
+        save_state(home, &grant.group_id, state)?;
+    }
+    object(json!({"offer":packet, "credit_exhausted":false}))
+}
+
+fn dispatch_members(args: &Map<String, Value>) -> Result<Vec<String>, OpError> {
+    let ids = args
+        .get("attempt_ids")
+        .and_then(Value::as_array)
+        .filter(|v| (1..=MAX_BATCH).contains(&v.len()))
+        .ok_or_else(|| OpError::new("invalid_args", "Bounded ordered attempt_ids required"))?;
+    let mut result = Vec::with_capacity(ids.len());
+    for item in ids {
+        let id = item
+            .as_str()
+            .filter(|id| !id.is_empty() && id.len() <= 128)
+            .ok_or_else(|| OpError::new("invalid_args", "Invalid attempt identifier"))?;
+        if result.iter().any(|known| known == id) {
+            return Err(OpError::new("invalid_args", "Duplicate attempt identifier"));
+        }
+        result.push(id.to_owned());
+    }
+    Ok(result)
+}
+
+pub(super) fn dispatch(
+    home: &HomeLayout,
+    grant: &Grant,
+    group: &GroupDoc,
+    state: &mut State,
+    op: &str,
+    args: &Map<String, Value>,
+) -> OpResult {
+    let starting = op == "lease.start";
+    args_only(
+        args,
+        if starting {
+            &["lease_id", "lease_generation", "dispatch_id", "attempt_ids"]
+        } else {
+            &[
+                "lease_id",
+                "lease_generation",
+                "dispatch_id",
+                "outcome",
+                "retryable",
+                "error_code",
+            ]
+        },
+    )?;
+    let current = lease(state, grant, args)?.clone();
+    if current.receiver != "gateway" {
+        return Err(OpError::new(
+            "receiver_transport_conflict",
+            "Gateway lease required",
+        ));
+    }
+    let id = string(args, "dispatch_id")?;
+    if id.len() > 128 {
+        return Err(OpError::new("invalid_args", "Invalid dispatch identifier"));
+    }
+    let position = state.dispatches.iter().position(|record| {
+        record.id == id
+            && record.lease_generation == current.generation
+            && record.actor == grant.actor_id
+    });
+    if starting {
+        let attempt_ids = dispatch_members(args)?;
+        if let Some(position) = position {
+            let existing = &state.dispatches[position];
+            if existing.attempt_ids != attempt_ids {
+                return Err(OpError::new(
+                    "dispatch_conflict",
+                    "Dispatch membership changed",
+                ));
+            }
+            return object(existing.public());
+        }
+        let indexes = state
+            .attempts
+            .iter()
+            .enumerate()
+            .filter(|(_, attempt)| {
+                scoped(attempt, grant)
+                    && claimed(attempt, &current)
+                    && attempt.kind == "chat"
+                    && attempt.state == "offered"
+            })
+            .take(attempt_ids.len())
+            .map(|(index, _)| index)
+            .collect::<Vec<_>>();
+        if indexes.len() != attempt_ids.len()
+            || indexes
+                .iter()
+                .zip(&attempt_ids)
+                .any(|(index, id)| &state.attempts[*index].id != id)
+        {
+            return Err(OpError::new(
+                "dispatch_conflict",
+                "Dispatch must start at the ordered offers head",
+            ));
+        }
+        for index in &indexes {
+            let previous = &state.attempts[*index].dispatch_id;
+            if !previous.is_empty()
+                && state.dispatches.iter().any(|record| {
+                    &record.id == previous
+                        && record.lease_generation == current.generation
+                        && record.actor == grant.actor_id
+                        && record.outcome == "deferred"
+                        && record.attempt_ids != attempt_ids
+                })
+            {
+                return Err(OpError::new(
+                    "dispatch_conflict",
+                    "Deferred dispatch membership changed",
+                ));
+            }
+        }
+        if state.attempts.iter().any(|attempt| {
+            scoped(attempt, grant) && claimed(attempt, &current) && attempt.state == "started"
+        }) {
+            return Err(OpError::new(
+                "dispatch_conflict",
+                "Another dispatch has started",
+            ));
+        }
+        let deadline = now_ms().saturating_add(ATTEMPT_MS);
+        for index in indexes {
+            let attempt = &mut state.attempts[index];
+            attempt.state = "started".into();
+            attempt.boot = boot().into();
+            attempt.deadline_ms = deadline;
+            attempt.dispatch_id = id.clone();
+        }
+        let record = Dispatch {
+            id,
+            lease_generation: current.generation,
+            actor: grant.actor_id.clone(),
+            attempt_ids,
+            outcome: "started".into(),
+            settlement: None,
+        };
+        let result = record.public();
+        state.dispatches.push(record);
+        save_state(home, &grant.group_id, state)?;
+        return object(result);
+    }
+    let outcome = string(args, "outcome")?;
+    if !matches!(
+        outcome.as_str(),
+        "accepted" | "deferred" | "refused" | "failed" | "uncertain"
+    ) {
+        return Err(OpError::new("invalid_args", "Invalid batch outcome"));
+    }
+    let retryable = match args.get("retryable") {
+        Some(value) => value
+            .as_bool()
+            .ok_or_else(|| OpError::new("invalid_args", "Invalid retryable flag"))?,
+        None => outcome != "accepted",
+    };
+    let error_code = match args.get("error_code") {
+        None | Some(Value::Null) => None,
+        Some(value) => Some(
+            value
+                .as_str()
+                .filter(|s| {
+                    s.len() <= 128 && s.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+                })
+                .ok_or_else(|| OpError::new("invalid_args", "Invalid outcome error code"))?
+                .to_owned(),
+        ),
+    };
+    let fingerprint =
+        digest(&serde_json::to_vec(&(&outcome, retryable, &error_code)).map_err(OpError::invalid)?);
+    let position =
+        position.ok_or_else(|| OpError::new("dispatch_not_found", "Dispatch unavailable"))?;
+    let record = &state.dispatches[position];
+    if record.outcome != "started" {
+        if record.settlement.as_deref() == Some(fingerprint.as_str()) {
+            return object(record.public());
+        }
+        return Err(OpError::new(
+            "dispatch_conflict",
+            "Dispatch already settled",
+        ));
+    }
+    let mut indexes = Vec::with_capacity(record.attempt_ids.len());
+    for attempt_id in &record.attempt_ids {
+        indexes.push(
+            state
+                .attempts
+                .iter()
+                .position(|attempt| {
+                    &attempt.id == attempt_id
+                        && scoped(attempt, grant)
+                        && claimed(attempt, &current)
+                        && attempt.dispatch_id == id
+                        && attempt.state == "started"
+                })
+                .ok_or_else(|| {
+                    OpError::new("attempt_conflict", "Dispatch attempt is unavailable")
+                })?,
+        );
+    }
+    for index in indexes.iter().copied() {
+        let attempt = &mut state.attempts[index];
+        if outcome == "deferred" {
+            attempt.state = "offered".into();
+            attempt.deadline_ms = 0;
+        } else {
+            attempt.state = outcome.clone();
+            attempt.error_code = error_code.clone();
+            attempt.retryable = retryable;
+        }
+    }
+    let record = &mut state.dispatches[position];
+    record.outcome = outcome.clone();
+    record.settlement = Some(fingerprint);
+    let result = record.public();
+    save_state(home, &grant.group_id, state)?;
+    if outcome != "deferred" {
+        for index in indexes {
+            append_receipt(home, group, &state.attempts[index])?;
+        }
+    }
+    object(result)
+}
+
+pub(super) fn event_target(
+    home: &HomeLayout,
+    grant: &Grant,
+    args: &Map<String, Value>,
+) -> Result<String, OpError> {
+    if !args.contains_key("event_ref") {
+        return string(args, "event_id");
+    }
+    if args.contains_key("event_id") || args.contains_key("before_event_id") {
+        return Err(OpError::new("invalid_args", "Select one exact event"));
+    }
+    let reference = string(args, "event_ref")?;
+    let state = read_state(home, &grant.group_id)?;
+    state
+        .attempts
+        .iter()
+        .find(|attempt| {
+            attempt.id == reference
+                && scoped(attempt, grant)
+                && attempt.kind == "chat"
+                && state.direct_reads.iter().any(|read| {
+                    read.actor == grant.actor_id
+                        && read.actor_generation == grant.actor_generation
+                        && read.attempt_ids.contains(&attempt.id)
+                })
+        })
+        .map(|attempt| attempt.event_id.clone())
+        .ok_or_else(|| OpError::new("event_not_found", "Scoped reference unavailable"))
+}
+
+pub(super) fn direct_ack(
+    home: &HomeLayout,
+    grant: &Grant,
+    group: &GroupDoc,
+    args: &Map<String, Value>,
+) -> OpResult {
+    args_only(args, &["receipt"])?;
+    let receipt = string(args, "receipt")?;
+    let mut state = read_state(home, &grant.group_id)?;
+    sweep(home, &grant.group_id, &mut state)?;
+    let index = state
+        .direct_reads
+        .iter()
+        .position(|read| {
+            read.receipt == receipt
+                && read.actor == grant.actor_id
+                && read.actor_generation == grant.actor_generation
+        })
+        .ok_or_else(|| OpError::new("receipt_not_found", "Direct receipt unavailable"))?;
+    let read = &state.direct_reads[index];
+    if read.acknowledged {
+        return object(read.public());
+    }
+    if read.expires_ms <= now_ms() {
+        return Err(OpError::new("receipt_expired", "Direct receipt expired"));
+    }
+    let mut indexes = Vec::with_capacity(read.attempt_ids.len());
+    for id in &read.attempt_ids {
+        indexes.push(
+            state
+                .attempts
+                .iter()
+                .position(|attempt| {
+                    &attempt.id == id
+                        && scoped(attempt, grant)
+                        && attempt.state == "direct_retrieved"
+                })
+                .ok_or_else(|| {
+                    OpError::new("attempt_conflict", "Direct attempt cannot be acknowledged")
+                })?,
+        );
+    }
+    for position in indexes.iter().copied() {
+        let attempt = &mut state.attempts[position];
+        attempt.state = "direct_read".into();
+        attempt.retryable = false;
+    }
+    state.direct_reads[index].acknowledged = true;
+    let result = state.direct_reads[index].public();
+    save_state(home, &grant.group_id, &state)?;
+    for position in indexes {
+        append_receipt(home, group, &state.attempts[position])?;
+    }
+    object(result)
+}
