diff --git a/crates/cccc-core/src/inbox/explicit.rs b/crates/cccc-core/src/inbox/explicit.rs
new file mode 100644
index 00000000..7357c806
--- /dev/null
+++ b/crates/cccc-core/src/inbox/explicit.rs
@@ -0,0 +1,220 @@
+//! Explicit, bounded, operation-identified Mail reads sharing the native journal.
+use super::*;
+
+/// Durable payload-free operation decision embedded in the native read fact.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+pub struct MailReadDecision {
+    pub operation_id: String,
+    pub actor_generation: String,
+    pub fingerprint: String,
+    pub before_cursor: String,
+    pub after_cursor: String,
+    pub event_ids: Vec<String>,
+    pub outcome: String,
+    pub read_event_id: String,
+}
+
+/// Domain outcomes retain IO failures separately from rejected preconditions.
+#[derive(Debug)]
+pub enum MailReadResult {
+    Completed {
+        messages: Vec<Event>,
+        receipt: MailReadDecision,
+        has_more: bool,
+        already_completed: bool,
+    },
+    CursorConflict,
+    OperationConflict,
+    ContentLimit,
+}
+
+fn decision(
+    home: &HomeLayout,
+    group: &GroupDoc,
+    actor: &str,
+    operation_id: &str,
+) -> io::Result<Option<MailReadDecision>> {
+    let generation = crate::actors::find(group, actor)
+        .map(crate::actors::generation_identity)
+        .unwrap_or_default();
+    let mut found = None;
+    let path = GroupStore::new(home.clone())?.ledger_path(&group.group_id)?;
+    ledger::visit_newest_first(&path, |event| {
+        if event.kind == "mail.read"
+            && event.data.get("actor_id").and_then(Value::as_str) == Some(actor)
+        {
+            if let Some(value) = event.data.get("operation") {
+                if let Ok(value) = serde_json::from_value::<MailReadDecision>(value.clone()) {
+                    if value.actor_generation == generation && value.operation_id == operation_id {
+                        found = Some(value);
+                        return ControlFlow::Break(());
+                    }
+                }
+            }
+        }
+        ControlFlow::Continue(())
+    })?;
+    Ok(found)
+}
+
+fn locked<T>(
+    home: &HomeLayout,
+    group: &GroupDoc,
+    action: impl FnOnce() -> io::Result<T>,
+) -> io::Result<T> {
+    let lock = path(home, &group.group_id)?.with_file_name("read_cursors.json.lock");
+    with_exclusive_lock(&lock, || {
+        recover_pending_locked(home, &group.group_id)?;
+        action()
+    })
+}
+
+/// Inspect an operation decision without initiating a new read.
+pub fn mail_read_receipt(
+    home: &HomeLayout,
+    group: &GroupDoc,
+    actor: &str,
+    operation_id: &str,
+) -> io::Result<Option<MailReadDecision>> {
+    locked(home, group, || decision(home, group, actor, operation_id))
+}
+
+/// Capture a consistent non-consuming next-batch view and authoritative cursor.
+pub fn explicit_mail_peek(
+    home: &HomeLayout,
+    group: &GroupDoc,
+    actor: &str,
+    limit: usize,
+) -> io::Result<(Vec<Event>, String, String, String)> {
+    locked(home, group, || {
+        let state = load_raw(home, &group.group_id)?;
+        let messages = projection::pages(home, group, &[actor.to_owned()], &state, limit.min(201))?
+            .remove(actor)
+            .unwrap_or_default();
+        let cursor = stored_cursor_record(home, &group.group_id, actor)?;
+        Ok((messages, cursor.event_id, cursor.ts, cursor.updated_at))
+    })
+}
+
+/// Select a complete prefix before the journal commits, under the native read lock.
+/// The pure callback includes the caller's full response-envelope/reference reserve.
+#[allow(clippy::too_many_arguments)]
+pub fn explicit_mail_read(
+    home: &HomeLayout,
+    group: &GroupDoc,
+    actor: &str,
+    operation_id: &str,
+    fingerprint: &str,
+    expected_cursor: &str,
+    limit: usize,
+    fits: impl Fn(&[Event], &MailReadDecision, bool) -> io::Result<bool>,
+) -> io::Result<MailReadResult> {
+    locked(home, group, || {
+        if let Some(receipt) = decision(home, group, actor, operation_id)? {
+            return Ok(if receipt.fingerprint == fingerprint {
+                MailReadResult::Completed {
+                    messages: Vec::new(),
+                    receipt,
+                    has_more: false,
+                    already_completed: true,
+                }
+            } else {
+                MailReadResult::OperationConflict
+            });
+        }
+        let expected = stored_cursor_record(home, &group.group_id, actor)?;
+        if expected.event_id != expected_cursor {
+            return Ok(MailReadResult::CursorConflict);
+        }
+        let mut state = load_raw(home, &group.group_id)?;
+        let mut candidates =
+            projection::pages(home, group, &[actor.to_owned()], &state, limit.min(200) + 1)?
+                .remove(actor)
+                .unwrap_or_default();
+        let mut fact = Event::new("mail.read", &group.group_id);
+        fact.by = actor.to_owned();
+        let mut receipt = MailReadDecision {
+            operation_id: operation_id.to_owned(),
+            actor_generation: crate::actors::find(group, actor)
+                .map(crate::actors::generation_identity)
+                .unwrap_or_default(),
+            fingerprint: fingerprint.to_owned(),
+            before_cursor: expected.event_id.clone(),
+            after_cursor: expected.event_id.clone(),
+            event_ids: Vec::new(),
+            outcome: "empty".into(),
+            read_event_id: fact.id.clone(),
+        };
+        let available = candidates.len();
+        let mut selected = 0;
+        for count in 1..=available.min(limit.min(200)) {
+            let mut next = receipt.clone();
+            next.after_cursor = candidates[count - 1].id.clone();
+            next.event_ids.push(next.after_cursor.clone());
+            next.outcome = "consumed".into();
+            if !fits(&candidates[..count], &next, available > count)? {
+                break;
+            }
+            receipt = next;
+            selected = count;
+        }
+        if available > 0 && selected == 0 || available == 0 && !fits(&[], &receipt, false)? {
+            return Ok(MailReadResult::ContentLimit);
+        }
+        candidates.truncate(selected);
+        let target = if let Some(last) = candidates.last() {
+            PendingCursor {
+                event_id: last.id.clone(),
+                ts: last.ts.clone(),
+                updated_at: cccc_contracts::utc_now(),
+            }
+        } else {
+            expected.clone()
+        };
+        let pending = PendingRead {
+            schema: PENDING_READ_SCHEMA,
+            group_id: group.group_id.clone(),
+            actor_id: actor.to_owned(),
+            expected,
+            target: target.clone(),
+            operation: Some(receipt.clone()),
+        };
+        fact.data = json!({"actor_id":actor,"event_id":receipt.after_cursor,"operation":receipt})
+            .as_object()
+            .unwrap()
+            .clone();
+        write_json(&pending_path(home, &group.group_id)?, &pending)?;
+        fault(1)?;
+        ledger::append(
+            &GroupStore::new(home.clone())?.ledger_path(&group.group_id)?,
+            &fact,
+        )?;
+        fault(2)?;
+        if !candidates.is_empty() {
+            state.cursors.insert(actor.to_owned(), target.event_id);
+            save(home, &group.group_id, &state, actor, &target.ts)?;
+        }
+        fault(3)?;
+        let _ = clear_pending(home, &group.group_id);
+        Ok(MailReadResult::Completed {
+            messages: candidates,
+            receipt,
+            has_more: available > selected,
+            already_completed: false,
+        })
+    })
+}
+
+#[cfg(test)]
+thread_local! { static FAULT: std::cell::Cell<u8> = const { std::cell::Cell::new(0) }; }
+fn fault(phase: u8) -> io::Result<()> {
+    #[cfg(test)]
+    if FAULT.with(|value| value.get()) == phase {
+        return Err(io::Error::other("injected journal interruption"));
+    }
+    let _ = phase;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests;
