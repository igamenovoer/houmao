+fn external_notice_offer_is_content_free_and_does_not_consume_mail() {
+    let f = Fixture::new();
+    let lease = f.lease(&f.bob);
+    // Native source and policy are exercised without a stand-in notice offer.
+    let mut event = Event::new("chat.message", &f.group.group_id);
+    event.by = "alice".into();
+    event.data = json!({"to":["bob"],"message_mode":"mail","text":"secret Mail body"})
+        .as_object()
+        .unwrap()
+        .clone();
+    event.ts = (chrono::Utc::now() - chrono::Duration::seconds(2000)).to_rfc3339();
+    let path = GroupStore::new(f.home.clone())
+        .unwrap()
+        .ledger_path(&f.group.group_id)
+        .unwrap();
+    ledger::append(&path, &event).unwrap();
+    super::super::automation_runtime::tick_group(
+        &f.home,
+        &f.group.group_id,
+        true,
+        &std::sync::atomic::AtomicBool::new(false),
+    );
+    let offer = f.rpc(&f.bob, "lease.next", lease.clone()).unwrap()["offer"].clone();
+    assert_eq!(offer["kind"], "mail_notice");
+    assert!(!offer["text"].as_str().unwrap().contains("secret Mail body"));
+    assert!(offer["pending_count"].as_u64().unwrap() > 0);
+    assert_eq!(
+        f.rpc(&f.bob, "mail.cursor", json!({})).unwrap()["cursor"]["event_id"],
+        ""
+    );
+    let mut outcome = lease.clone();
+    outcome["attempt_id"] = offer["attempt_id"].clone();
+    outcome["outcome"] = json!("refused");
+    f.rpc(&f.bob, "lease.outcome", outcome).unwrap();
+    super::super::automation_runtime::tick_group(
+        &f.home,
+        &f.group.group_id,
+        true,
+        &std::sync::atomic::AtomicBool::new(false),
+    );
+    assert!(f.rpc(&f.bob, "lease.next", lease).unwrap()["offer"].is_null());
+}
