diff --git a/crates/cccc-daemon/src/ops/external_receiver/mail.rs b/crates/cccc-daemon/src/ops/external_receiver/mail.rs
new file mode 100644
index 00000000..b994ef7c
--- /dev/null
+++ b/crates/cccc-daemon/src/ops/external_receiver/mail.rs
@@ -0,0 +1,237 @@
+//! Deferred Mail operations; all consuming decisions use the native core journal.
+use super::*;
+use cccc_core::inbox::{self, MailReadDecision, MailReadResult};
+
+const MAX_BYTES: usize = 1048576;
+fn bounded(
+    args: &Map<String, Value>,
+    name: &str,
+    default: usize,
+    minimum: usize,
+    maximum: usize,
+) -> Result<usize, OpError> {
+    args.get(name).map_or(Ok(default), |v| {
+        v.as_u64()
+            .and_then(|v| usize::try_from(v).ok())
+            .filter(|v| (minimum..=maximum).contains(v))
+            .ok_or_else(|| OpError::new("invalid_args", "Invalid Mail bound"))
+    })
+}
+fn identifier(value: &str, empty: bool) -> bool {
+    (empty || !value.is_empty())
+        && value.len() <= 512
+        && value
+            .bytes()
+            .all(|v| v.is_ascii_alphanumeric() || b"_.:-".contains(&v))
+}
+fn public(receipt: &MailReadDecision) -> Value {
+    json!({"operation_id":receipt.operation_id,"actor_generation":receipt.actor_generation,"before_cursor":receipt.before_cursor,"after_cursor":receipt.after_cursor,"event_ids":receipt.event_ids,"outcome":receipt.outcome,"read_event_id":receipt.read_event_id})
+}
+fn read_result(
+    messages: &[Event],
+    receipt: &MailReadDecision,
+    has_more: bool,
+    repeated: bool,
+) -> Value {
+    json!({"messages":messages,"cursor":{"event_id":receipt.after_cursor,"ts":messages.last().map(|e|e.ts.as_str()).unwrap_or(""),"updated_at":""},"has_more":has_more,"outcome":if repeated {"already_completed"} else {receipt.outcome.as_str()},"receipt":public(receipt)})
+}
+fn fits(
+    value: &Value,
+    count: usize,
+    max_bytes: usize,
+    overhead: usize,
+    per_event: usize,
+) -> std::io::Result<bool> {
+    Ok(serde_json::to_vec(&json!({"ok":true,"result":value}))
+        .map_err(std::io::Error::other)?
+        .len()
+        .saturating_add(overhead)
+        .saturating_add(per_event.saturating_mul(count))
+        <= max_bytes)
+}
+pub(super) fn rpc(
+    home: &HomeLayout,
+    grant: &Grant,
+    group: &GroupDoc,
+    op: &str,
+    args: &Map<String, Value>,
+) -> OpResult {
+    if op == "mail.cursor" {
+        args_only(args, &[])?;
+        let (_, id, ts, updated_at) =
+            inbox::explicit_mail_peek(home, group, &grant.actor_id, 0).map_err(OpError::io)?;
+        if !identifier(&id, true) {
+            return Err(OpError::new(
+                "content_limit",
+                "Native cursor exceeds supported reference limit",
+            ));
+        }
+        return object(json!({"cursor":{"event_id":id,"ts":ts,"updated_at":updated_at}}));
+    }
+    if op == "mail.read-receipts" {
+        args_only(args, &["operation_id"])?;
+        let id = string(args, "operation_id")?;
+        if id.len() > 128 {
+            return Err(OpError::new("invalid_args", "operation_id too long"));
+        }
+        let receipt =
+            inbox::mail_read_receipt(home, group, &grant.actor_id, &id).map_err(OpError::io)?;
+        return object(match receipt {
+            Some(v) => json!({"found":true,"receipt":public(&v)}),
+            None => json!({"found":false,"operation_id":id}),
+        });
+    }
+    args_only(
+        args,
+        if op == "mail.read" {
+            &[
+                "operation_id",
+                "expected_cursor",
+                "limit",
+                "max_bytes",
+                "response_overhead_bytes",
+                "per_event_overhead_bytes",
+            ]
+        } else {
+            &[
+                "limit",
+                "max_bytes",
+                "response_overhead_bytes",
+                "per_event_overhead_bytes",
+            ]
+        },
+    )?;
+    let limit = bounded(args, "limit", 50, 1, 200)?;
+    let bytes = bounded(args, "max_bytes", 262144, 1024, MAX_BYTES)?;
+    let overhead = bounded(args, "response_overhead_bytes", 0, 0, MAX_BYTES)?;
+    let per_event = bounded(args, "per_event_overhead_bytes", 0, 0, MAX_BYTES)?;
+    if overhead >= bytes {
+        return Err(OpError::new(
+            "content_limit",
+            "Response metadata exceeds selected limit",
+        ));
+    }
+    if op == "mail.peek" {
+        let (mut messages, id, ts, updated_at) =
+            inbox::explicit_mail_peek(home, group, &grant.actor_id, limit + 1)
+                .map_err(OpError::io)?;
+        if !identifier(&id, true) {
+            return Err(OpError::new(
+                "content_limit",
+                "Native cursor exceeds supported reference limit",
+            ));
+        }
+        let available = messages.len();
+        let mut selected = 0;
+        for count in 0..=available.min(limit) {
+            if messages[..count].iter().any(|e| !identifier(&e.id, false)) {
+                break;
+            }
+            let candidate = json!({"messages":&messages[..count],"cursor":{"event_id":id,"ts":ts,"updated_at":updated_at},"has_more":available>count,"count_accuracy":"bounded","consumed":false});
+            if !fits(&candidate, count, bytes, overhead, per_event).map_err(OpError::io)? {
+                break;
+            }
+            selected = count;
+        }
+        if available > 0 && selected == 0 {
+            return Err(OpError::new(
+                "content_limit",
+                "First pending Mail does not fit selected complete response limit",
+            ));
+        }
+        messages.truncate(selected);
+        let result = json!({"messages":messages,"cursor":{"event_id":id,"ts":ts,"updated_at":updated_at},"has_more":available>selected,"count_accuracy":"bounded","consumed":false});
+        if !fits(&result, selected, bytes, overhead, per_event).map_err(OpError::io)? {
+            return Err(OpError::new(
+                "content_limit",
+                "Response metadata exceeds selected limit",
+            ));
+        }
+        return object(result);
+    }
+    let id = string(args, "operation_id")?;
+    if id.len() > 128 {
+        return Err(OpError::new("invalid_args", "operation_id too long"));
+    }
+    let expected = args
+        .get("expected_cursor")
+        .and_then(Value::as_str)
+        .filter(|v| identifier(v, true))
+        .ok_or_else(|| OpError::new("invalid_args", "expected_cursor required"))?;
+    let fingerprint=digest(&serde_json::to_vec(&json!({"expected_cursor":expected,"limit":limit,"max_bytes":bytes,"response_overhead_bytes":overhead,"per_event_overhead_bytes":per_event})).map_err(OpError::invalid)?);
+    let result = inbox::explicit_mail_read(
+        home,
+        group,
+        &grant.actor_id,
+        &id,
+        &fingerprint,
+        expected,
+        limit,
+        |messages, receipt, more| {
+            if messages.iter().any(|e| !identifier(&e.id, false))
+                || !identifier(&receipt.after_cursor, true)
+            {
+                return Ok(false);
+            }
+            fits(
+                &read_result(messages, receipt, more, false),
+                messages.len(),
+                bytes,
+                overhead,
+                per_event,
+            )
+        },
+    )
+    .map_err(OpError::io)?;
+    match result {
+        MailReadResult::Completed {
+            messages,
+            receipt,
+            has_more,
+            already_completed,
+        } => object(read_result(
+            &messages,
+            &receipt,
+            has_more,
+            already_completed,
+        )),
+        MailReadResult::CursorConflict => Err(OpError::new(
+            "cursor_conflict",
+            "Expected Mail cursor is stale",
+        )),
+        MailReadResult::OperationConflict => Err(OpError::new(
+            "operation_conflict",
+            "Read operation ID has different inputs",
+        )),
+        MailReadResult::ContentLimit => Err(OpError::new(
+            "content_limit",
+            "Complete leading Mail does not fit selected response limit",
+        )),
+    }
+}
+
+/// Read only same-registration targeted notices, or ordinary visible chat sources.
+pub(super) fn offered_event(
+    home: &HomeLayout,
+    group: &GroupDoc,
+    actor: &str,
+    id: &str,
+) -> Result<Event, OpError> {
+    let path = GroupStore::new(home.clone())
+        .map_err(OpError::io)?
+        .ledger_path(&group.group_id)
+        .map_err(OpError::io)?;
+    let notice = ledger::inspect_status(&path, |events, _, generations| {
+        events[generations.get(actor).copied().unwrap_or(0)..]
+            .iter()
+            .find(|e| {
+                e.id == id
+                    && e.kind == "system.notify"
+                    && e.data["kind"] == "mail_notice"
+                    && e.data["target_actor_id"] == actor
+            })
+            .cloned()
+    })
+    .map_err(OpError::io)?;
+    notice.map_or_else(|| visible_event(home, group, actor, id), Ok)
+}
