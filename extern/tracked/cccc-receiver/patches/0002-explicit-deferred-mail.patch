+use super::*;
+use cccc_contracts::Actor;
+struct Fixture {
+    _temp: tempfile::TempDir,
+    home: HomeLayout,
+    group: GroupDoc,
+}
+impl Fixture {
+    fn new() -> Self {
+        let t = tempfile::tempdir().unwrap();
+        let home = HomeLayout::from_path(t.path()).unwrap();
+        let store = GroupStore::new(home.clone()).unwrap();
+        let mut group = store.create("explicit Mail", "").unwrap();
+        crate::actors::add(&mut group, Actor::new("peer")).unwrap();
+        store.save(&group).unwrap();
+        Self {
+            _temp: t,
+            home,
+            group,
+        }
+    }
+    fn mail(&self, text: &str) -> Event {
+        let mut e = Event::new("chat.message", &self.group.group_id);
+        e.by = "user".into();
+        e.data = json!({"to":["peer"],"message_mode":"mail","text":text})
+            .as_object()
+            .unwrap()
+            .clone();
+        ledger::append(
+            &GroupStore::new(self.home.clone())
+                .unwrap()
+                .ledger_path(&self.group.group_id)
+                .unwrap(),
+            &e,
+        )
+        .unwrap();
+        e
+    }
+    fn read(&self, id: &str, fingerprint: &str, cursor: &str) -> io::Result<MailReadResult> {
+        explicit_mail_read(
+            &self.home,
+            &self.group,
+            "peer",
+            id,
+            fingerprint,
+            cursor,
+            1,
+            |_, _, _| Ok(true),
+        )
+    }
+}
+#[test]
+fn decisions_reconcile_before_cursor_precondition() {
+    let f = Fixture::new();
+    let first = f.mail("first");
+    let second = f.mail("second");
+    let result = f.read("read1", "fp", "").unwrap();
+    let MailReadResult::Completed {
+        messages, receipt, ..
+    } = result
+    else {
+        panic!()
+    };
+    assert_eq!(messages[0].id, first.id);
+    assert_eq!(receipt.after_cursor, first.id);
+    assert!(matches!(
+        f.read("other", "fp", "").unwrap(),
+        MailReadResult::CursorConflict
+    ));
+    let repeat = f.read("read1", "fp", "").unwrap();
+    assert!(matches!(
+        repeat,
+        MailReadResult::Completed {
+            already_completed: true,
+            ..
+        }
+    ));
+    assert!(matches!(
+        f.read("read1", "changed", "").unwrap(),
+        MailReadResult::OperationConflict
+    ));
+    assert_eq!(
+        explicit_mail_peek(&f.home, &f.group, "peer", 50).unwrap().0[0].id,
+        second.id
+    );
+}
+#[test]
+fn empty_decision_survives_new_arrival() {
+    let f = Fixture::new();
+    let MailReadResult::Completed { receipt, .. } = f.read("empty", "fp", "").unwrap() else {
+        panic!()
+    };
+    assert_eq!(receipt.outcome, "empty");
+    f.mail("later");
+    assert!(
+        matches!(f.read("empty","fp","").unwrap(),MailReadResult::Completed{already_completed:true,messages,..} if messages.is_empty())
+    );
+    assert_eq!(
+        explicit_mail_peek(&f.home, &f.group, "peer", 50)
+            .unwrap()
+            .0
+            .len(),
+        1
+    );
+}
+#[test]
+fn size_rejection_precedes_pending_marker_and_fact() {
+    let f = Fixture::new();
+    f.mail("large");
+    let before = ledger::read_all(
+        &GroupStore::new(f.home.clone())
+            .unwrap()
+            .ledger_path(&f.group.group_id)
+            .unwrap(),
+    )
+    .unwrap()
+    .len();
+    let r = explicit_mail_read(
+        &f.home,
+        &f.group,
+        "peer",
+        "size",
+        "fp",
+        "",
+        10,
+        |_, _, _| Ok(false),
+    )
+    .unwrap();
+    assert!(matches!(r, MailReadResult::ContentLimit));
+    assert!(
+        mail_read_receipt(&f.home, &f.group, "peer", "size")
+            .unwrap()
+            .is_none()
+    );
+    assert_eq!(cursor(&f.home, &f.group.group_id, "peer").unwrap(), None);
+    assert!(!pending_path(&f.home, &f.group.group_id).unwrap().exists());
+    assert_eq!(
+        ledger::read_all(
+            &GroupStore::new(f.home.clone())
+                .unwrap()
+                .ledger_path(&f.group.group_id)
+                .unwrap()
+        )
+        .unwrap()
+        .len(),
+        before
+    );
+}
+#[test]
+fn native_journal_recovers_each_durable_boundary() {
+    for phase in 1..=3 {
+        let f = Fixture::new();
+        let first = f.mail("first");
+        let second = f.mail("second");
+        FAULT.with(|v| v.set(phase));
+        assert!(f.read("crash", "fp", "").is_err());
+        FAULT.with(|v| v.set(0));
+        let receipt = mail_read_receipt(&f.home, &f.group, "peer", "crash").unwrap();
+        if phase == 1 {
+            assert!(receipt.is_none());
+            assert_eq!(cursor(&f.home, &f.group.group_id, "peer").unwrap(), None);
+            assert_eq!(
+                explicit_mail_peek(&f.home, &f.group, "peer", 50).unwrap().0[0].id,
+                first.id
+            );
+        } else {
+            assert_eq!(receipt.unwrap().event_ids, vec![first.id.clone()]);
+            assert_eq!(
+                cursor(&f.home, &f.group.group_id, "peer").unwrap(),
+                Some(first.id)
+            );
+            assert_eq!(
+                explicit_mail_peek(&f.home, &f.group, "peer", 50).unwrap().0[0].id,
+                second.id
+            );
+            assert!(matches!(
+                f.read("crash", "fp", "").unwrap(),
+                MailReadResult::Completed {
+                    already_completed: true,
+                    ..
+                }
+            ));
+        }
+        assert!(!pending_path(&f.home, &f.group.group_id).unwrap().exists());
+    }
+}
+#[test]
+fn empty_fact_recovers_without_cursor_publication() {
+    for phase in 1..=3 {
+        let f = Fixture::new();
+        FAULT.with(|v| v.set(phase));
+        assert!(f.read("empty-crash", "fp", "").is_err());
+        FAULT.with(|v| v.set(0));
+        let receipt = mail_read_receipt(&f.home, &f.group, "peer", "empty-crash").unwrap();
+        assert_eq!(receipt.is_some(), phase > 1);
+        if let Some(receipt) = receipt {
+            assert_eq!(receipt.outcome, "empty");
+        }
+        assert!(
+            cursor(&f.home, &f.group.group_id, "peer")
+                .unwrap()
+                .is_none()
+        );
+    }
+}
+#[test]
+fn distinct_concurrent_reads_share_the_native_lock() {
+    let f = Fixture::new();
+    f.mail("one");
+    f.mail("two");
+    let barrier = std::sync::Arc::new(std::sync::Barrier::new(2));
+    let handles = (0..2)
+        .map(|i| {
+            let b = barrier.clone();
+            let h = f.home.clone();
+            let g = f.group.clone();
+            std::thread::spawn(move || {
+                b.wait();
+                explicit_mail_read(
+                    &h,
+                    &g,
+                    "peer",
+                    &format!("read{i}"),
+                    "fp",
+                    "",
+                    1,
+                    |_, _, _| Ok(true),
+                )
+                .unwrap()
+            })
+        })
+        .collect::<Vec<_>>();
+    let results = handles
+        .into_iter()
+        .map(|h| h.join().unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(
+        results
+            .iter()
+            .filter(|v| matches!(v, MailReadResult::Completed { .. }))
+            .count(),
+        1
+    );
+    assert_eq!(
+        results
+            .iter()
+            .filter(|v| matches!(v, MailReadResult::CursorConflict))
+            .count(),
+        1
+    );
+    assert_eq!(
+        explicit_mail_peek(&f.home, &f.group, "peer", 50)
+            .unwrap()
+            .0
+            .len(),
+        1
+    );
+}
+#[test]
+fn native_consumer_cannot_interleave_cursor_comparison_and_commit() {
+    let f = Fixture::new();
+    let first = f.mail("one");
+    let second = f.mail("two");
+    let h = f.home.clone();
+    let g = f.group.clone();
+    let started = std::sync::Arc::new(std::sync::Barrier::new(2));
+    let b = started.clone();
+    let native = std::thread::spawn(move || {
+        b.wait();
+        consume_unread(&h, &g, "peer", "peer", 1).unwrap()
+    });
+    started.wait();
+    let explicit = f.read("gateway", "fp", "").unwrap();
+    let native = native.join().unwrap();
+    match explicit {
+        MailReadResult::Completed { messages, .. } => {
+            assert_eq!(messages[0].id, first.id);
+            assert_eq!(native.messages[0].id, second.id);
+        }
+        MailReadResult::CursorConflict => {
+            assert_eq!(native.messages[0].id, first.id);
+            assert_eq!(
+                explicit_mail_peek(&f.home, &f.group, "peer", 50).unwrap().0[0].id,
+                second.id
+            );
+        }
+        _ => panic!(),
+    }
+}
+#[test]
+fn recreation_does_not_inherit_old_decisions() {
+    let mut f = Fixture::new();
+    f.read("empty", "fp", "").unwrap();
+    f.group.actors[0].generation = uuid::Uuid::new_v4().to_string();
+    assert!(
+        mail_read_receipt(&f.home, &f.group, "peer", "empty")
+            .unwrap()
+            .is_none()
+    );
+}
